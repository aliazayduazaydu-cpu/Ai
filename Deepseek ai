-- دوال ESP
local function applyHighlight(player)
    if player == LocalPlayer or not player.Character then return end
    local char = player.Character
    local old = char:FindFirstChild("ESP_Highlight")
    if old then old:Destroy() end
    if not State.ESP then return end

    local hl = Instance.new("Highlight")
    hl.Name = "ESP_Highlight"
    hl.FillColor = isEnemy(player) and Color3.fromRGB(255, 50, 50) or Color3.fromRGB(50, 255, 50)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.55
    hl.OutlineTransparency = 0.2
    hl.Parent = char
end

local function applyNameTag(player)
    if player == LocalPlayer or not player.Character then return end
    local head = player.Character:FindFirstChild("Head")
    if not head then return end
    local oldBg = head:FindFirstChild("ESP_NameGui")
    if oldBg then oldBg:Destroy() end
    if not State.NameESP then return end

    local bg = Instance.new("BillboardGui")
    bg.Name = "ESP_NameGui"
    bg.Size = UDim2.new(0, 200, 0, 50)
    bg.StudsOffset = Vector3.new(0, 2.5, 0)
    bg.AlwaysOnTop = true
    bg.Parent = head

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.fromScale(1, 1)
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = isEnemy(player) and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(80, 255, 80)
    lbl.TextStrokeTransparency = 0
    lbl.Font = Enum.Font.GothamBold
    lbl.TextScaled = true
    lbl.Parent = bg

    task.spawn(function()
        while bg.Parent and State.NameESP do
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            local tHRP = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
            if hrp and tHRP then
                local dist = math.floor((hrp.Position - tHRP.Position).Magnitude)
                lbl.Text = string.format("%s [%dm]", player.Name, dist)
            else
                lbl.Text = player.Name
            end
            task.wait(0.3)
        end
    end)
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.5)
        applyHighlight(p); applyNameTag(p)
    end)
end)

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        p.CharacterAdded:Connect(function()
            task.wait(0.5)
            applyHighlight(p); applyNameTag(p)
        end)
    end
end

task.spawn(function()
