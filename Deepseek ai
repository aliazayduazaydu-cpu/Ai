local function safeSet(paragraph, text)
    if not paragraph then return end
    pcall(function() paragraph:Set(text) end)
    pcall(function() paragraph.Text = text end)
    pcall(function() paragraph:Update(text) end)
end

local function getChar()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function getHRP()
    local c = LocalPlayer.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end

local function isEnemy(plr)
    if plr == LocalPlayer then return false end
    if not State.TeamCheck then return true end
    if plr.Team and LocalPlayer.Team then
        return plr.Team ~= LocalPlayer.Team
    end
    return true
end

