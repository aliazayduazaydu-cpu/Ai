--==================================================
-- Drawing-based ESP (Box, Tracer, FOV)
--==================================================
local DrawingOK, Drawing = pcall(function() return Drawing end)
if DrawingOK and Drawing then
    local boxes, tracers = {}, {}
    local fovCircle = Drawing.new("Circle")
    fovCircle.Thickness = 2; fovCircle.Color = Color3.fromRGB(0,255,0)
    fovCircle.Filled = false; fovCircle.Radius = 100; fovCircle.Visible = false

    RunService.RenderStepped:Connect(function()
        -- FOV Circle
        if State.FOVCircle then
            fovCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
            fovCircle.Visible = true
        else
            fovCircle.Visible = false
        end

        -- Box ESP
        if not State.BoxESP then
            for _, b in pairs(boxes) do b:Remove() end
            boxes = {}
        else
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character
                   and p.Character:FindFirstChild("HumanoidRootPart") then
                    local box = boxes[p]
                    if not box then
                        box = Drawing.new("Square")
                        box.Thickness = 1; box.Filled = false
                        boxes[p] = box
                    end
                    local hrp = p.Character.HumanoidRootPart
                    local sp, onScreen = Camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local dist = (Camera.CFrame.Position - hrp.Position).Magnitude
                        local h = 800 / dist
                        local w = h / 2
                        box.Size = Vector2.new(w, h)
                        box.Position = Vector2.new(sp.X - w/2, sp.Y - h/2)
                        box.Color = isEnemy(p) and Color3.fromRGB(255,0,0) or Color3.fromRGB(0,255,0)
                        box.Visible = true
                    else
                        box.Visible = false
                    end
                end
            end
        end

        -- Tracer ESP
        if not State.TracerESP then
            for _, t in pairs(tracers) do t:Remove() end
            tracers = {}
        else
            local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            for _, p in ipairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character
                   and p.Character:FindFirstChild("HumanoidRootPart") then
                    local t = tracers[p]
                    if not t then
                        t = Drawing.new("Line")
                        t.Thickness = 1
                        tracers[p] = t
                    end
                    local sp, onScreen = Camera:WorldToViewportPoint(
                        p.Character.HumanoidRootPart.Position)
                    if onScreen then
                        t.From = center; t.To = Vector2.new(sp.X, sp.Y)
                        t.Color = isEnemy(p) and Color3.fromRGB(255,0,0) or Color3.fromRGB(0,255,0)
                        t.Visible = true
                    else
                        t.Visible = false
                    end
                end
            end
        end
    end)
end

