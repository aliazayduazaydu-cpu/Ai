-- Highlight function
local function applyHL(p)
    if p == LocalPlayer or not p.Character then return end
    local c = p.Character
    local old = c:FindFirstChild("ESP_Highlight")
    if old then old:Destroy() end
    if not State.ESP then return end
    local hl = Instance.new("Highlight")
    hl.Name = "ESP_Highlight"
    hl.FillColor = isEnemy(p) and Color3.fromRGB(255,50,50) or Color3.fromRGB(50,255,50)
    hl.OutlineColor = Color3.fromRGB(255,255,255)
    hl.FillTransparency = 0.55
    hl.OutlineTransparency = 0.2
    hl.Parent = c
end

-- Name Tag function
local function applyName(p)
    if p == LocalPlayer or not p.Character then return end
    local head = p.Character:FindFirstChild("Head"); if not head then return end
    local old = head:FindFirstChild("ESP_NameGui"); if old then old:Destroy() end
    if not State.NameESP then return end
    local bg = Instance.new("BillboardGui")
    bg.Name = "ESP_NameGui"; bg.Size = UDim2.new(0,200,0,50)
    bg.StudsOffset = Vector3.new(0,2.5,0); bg.AlwaysOnTop = true; bg.Parent = head
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.fromScale(1,1); lbl.BackgroundTransparency = 1
    lbl.TextColor3 = isEnemy(p) and Color3.fromRGB(255,80,80) or Color3.fromRGB(80,255,80)
    lbl.TextStrokeTransparency = 0; lbl.Font = Enum.Font.GothamBold; lbl.TextScaled = true
    lbl.Parent = bg
    task.spawn(function()
        while bg.Parent and State.NameESP do
            local hrp = getHRP()
            local tH = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
            if hrp and tH then
                lbl.Text = string.format("%s [%dm]", p.Name,
                    math.floor((hrp.Position-tH.Position).Magnitude))
            else lbl.Text = p.Name end
            task.wait(0.3)
        end
    end)
end

for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then
        p.CharacterAdded:Connect(function()
            task.wait(0.5); applyHL(p); applyName(p)
        end)
    end
end

Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function()
        task.wait(0.5); applyHL(p); applyName(p)
    end)
end)

