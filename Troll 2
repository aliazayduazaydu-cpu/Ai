local function antiBangStart()
	local g = newGen("antibang")
	task.spawn(function()
		while alive("antibang", g) do
			task.wait()
			local r = myRoot()
			if r then
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= plr then
						local pr, ph = rootOf(p), hum(p)
						if pr and ph and ph.Health > 0 and (pr.Position - r.Position).Magnitude <= 2 then
							local back = r.CFrame
							r.CFrame = CFrame.new(10, -1000.51605, 10)
							task.wait()
							if alive("antibang", g) then r.CFrame = back end
						end
					end
				end
			end
		end
	end)
end

local function jerkStart()
	local g = newGen("jerk")
	task.spawn(function()
		local h = plr.Character and plr.Character:FindFirstChildWhichIsA("Humanoid")
		if not (h and h.RigType == Enum.HumanoidRigType.R15) then return end
		local anim = Instance.new("Animation")
		anim.AnimationId = "rbxassetid://698251653"
		local track = h:LoadAnimation(anim)
		while alive("jerk", g) do
			track:Play()
			track:AdjustSpeed(0.7)
			track.TimePosition = 0.6
			task.wait(0.01)
			while track.TimePosition < 0.7 and alive("jerk", g) do
				task.wait(0.01)
			end
			track:Stop()
		end
		track:Stop()
	end)
end

local function touchFlingStart()
	local g = newGen("touch")
	task.spawn(function()
		local v = 0.1
		while alive("touch", g) do
			RunService.Heartbeat:Wait()
			local c = plr.Character
			local r = c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso") or c:FindFirstChild("UpperTorso"))
			if c and r then
				local vel = r.Velocity
				r.Velocity = vel * 9999999 + Vector3.new(0, 10000, 0)
				RunService.RenderStepped:Wait()
				if c.Parent and r.Parent then r.Velocity = vel end
				RunService.Stepped:Wait()
				if c.Parent and r.Parent then
					r.Velocity = vel + Vector3.new(0, v, 0)
					v = -v
				end
			end
		end
	end)
end

local spinOn = false
RunService.RenderStepped:Connect(function(dt)
	if spinOn then
		local r = myRoot()
		if r then r.CFrame = r.CFrame * CFrame.Angles(0, math.rad(spinSpeed * dt * 60), 0) end
	end
end)

