-- ================= أدوات مساعدة =================
local function char(p) return p and p.Character end
local function hum(p) local c = char(p) return c and c:FindFirstChildOfClass("Humanoid") end
local function rootOf(p) local c = char(p) return c and c:FindFirstChild("HumanoidRootPart") end
local function myHum() return hum(plr) end
local function myRoot() return rootOf(plr) end

local function notify(text, dur)
	pcall(function()
		StarterGui:SetCore("SendNotification", {Title = "Ali hub", Text = text, Duration = dur or 4})
	end)
end

local function newGen(key)
	gens[key] = (gens[key] or 0) + 1
	return gens[key]
end
local function alive(key, g) return gens[key] == g end
local function stop(key) gens[key] = (gens[key] or 0) + 1 end

local function findPlayer(name, excludeSelf)
	if not name or name == "" then return nil end
	name = name:lower()
	if name == "random" then
		local list = {}
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= plr then table.insert(list, p) end
		end
		return #list > 0 and list[math.random(#list)] or nil
	end
	for _, p in ipairs(Players:GetPlayers()) do
		if not (excludeSelf and p == plr) then
			if p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name then
				return p
			end
		end
	end
	return nil
end

local function targetPlayer()
	return findPlayer(targetName, true)
end

local function teleportTo(tr, off)
	local r = myRoot()
	if r and tr then
		r.Velocity = Vector3.zero
		r.CFrame = tr.CFrame * off
	end
end

-- ================= الفلنج =================
local function flingPlayer(target, raid)
	local lr, lh = myRoot(), myHum()
	local tc = char(target)
	if not (lr and lh and tc) then return end
	local th = tc:FindFirstChildOfClass("Humanoid")
	local tRoot = tc:FindFirstChild("HumanoidRootPart")
	local head = tc:FindFirstChild("Head")
	local part = tRoot or head
	if not (th and part) then return end

	if lr.Velocity.Magnitude < 50 then oldPos = lr.CFrame end
	cam.CameraSubject = head or th

	local bv = Instance.new("BodyVelocity")
	bv.Name = "EpixVel"
	bv.Velocity = Vector3.new(9e8, 9e8, 9e8)
	bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bv.Parent = lr
	lh:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
	Workspace.FallenPartsDestroyHeight = 0 / 0

	local angle = 100
	local function place(off)
		lr.CFrame = CFrame.new(part.Position) * off * CFrame.Angles(math.rad(angle), 0, 0)
		lr.Velocity = Vector3.new(9e7, 9e8, 9e7)
		lr.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
	end
	local function step(off)
		place(off)
		task.wait()
	end

	local t0 = tick()
	while part.Parent and th.Parent and lh.Health > 0 and tick() - t0 < 0.3 do
		local md = th.MoveDirection
		local s = part.Velocity.Magnitude / 1.25
		if not raid and part.Velocity.Magnitude >= 50 then
			for _ = 1, 4 do step(CFrame.new() + md * s) end
			for _ = 1, 2 do step(CFrame.new() + md) end
		else
			angle = angle + 100
			step(CFrame.new(0, 1.5, 0) + md * s)
			step(CFrame.new(0, -1.5, 0) + md * s)
			step(CFrame.new(2.25, 1.5, -2.25) + md * s)
			step(CFrame.new(-2.25, -1.5, 2.25) + md * s)
			step(CFrame.new(0, 1.5, 0) + md)
			step(CFrame.new(0, -1.5, 0) + md)
		end
		if part.Velocity.Magnitude > 500 or th.Sit or lh.Health <= 0 then break end
	end

	bv:Destroy()
	lh:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
	cam.CameraSubject = lh

	if oldPos then
		local s0 = tick()
		repeat
			lr.CFrame = oldPos * CFrame.new(0, 0.5, 0)
			lr.Velocity = Vector3.zero
			lr.RotVelocity = Vector3.zero
			task.wait()
		until not lr.Parent or (lr.Position - oldPos.Position).Magnitude < 25 or tick() - s0 > 3
	end
	Workspace.FallenPartsDestroyHeight = FPDH
end

local function flingLoop(key, raid)
	local g = newGen(key)
	task.spawn(function()
		while alive(key, g) do
			local list = Players:GetPlayers()
			local p = list[math.random(#list)]
			if p ~= plr and p.Character then
				local h = myHum()
				if h then h.PlatformStand = true end
				flingPlayer(p, raid)
				local h2 = myHum()
				if h2 then h2.PlatformStand = false end
			end
			task.wait()
		end
	end)
end

-- ================= الهدف: Bang / Face Bang / Suck / Headsit / Facesit =================
local function bangStart()
	local t = targetPlayer()
	if not t or t == plr then notify("اختر هدفاً أولاً") return false end
	local g = newGen("bang")
	task.spawn(function()
		while alive("bang", g) do
			local tr = rootOf(t)
			if not tr then break end
			local h = myHum()
			if h then h.PlatformStand = true; h.Sit = false end
			for z = 1, 8 do
				if not alive("bang", g) then break end
				teleportTo(tr, CFrame.new(0, 0, z * 0.5))
				task.wait()
			end
			for z = 8, 1, -1 do
				if not alive("bang", g) then break end
				teleportTo(tr, CFrame.new(0, 0, z * 0.5))
				task.wait()
			end
			task.wait()
		end
	end)
	return true
end

local function faceBangStart()
	local t = targetPlayer()
	if not t or t == plr then notify("اختر هدفاً أولاً") return false end
	local g = newGen("facebang")
	task.spawn(function()
		while alive("facebang", g) do
			local hd = char(t) and char(t):FindFirstChild("Head")
			if not hd then break end
			for v = 1, 8 do
				if not alive("facebang", g) then break end
				local r = myRoot()
				if r then
					r.Velocity = Vector3.zero
					r.CFrame = (hd.CFrame + hd.CFrame.LookVector * (v * 0.5)) * CFrame.Angles(0, math.pi, 0)
				end
				task.wait()
			end
			for v = 8, 1, -1 do
				if not alive("facebang", g) then break end
				local r = myRoot()
				if r then
					r.Velocity = Vector3.zero
					r.CFrame = (hd.CFrame + hd.CFrame.LookVector * (v * 0.5)) * CFrame.Angles(0, math.pi, 0)
				end
				task.wait()
			end
			task.wait()
		end
	end)
	return true
end

local function stopHumanoidFlags()
	local h = myHum()
	if h then h.PlatformStand = false; h.Sit = false end
end

local function inverseBang()
	local t = targetPlayer()
	if not t or t == plr then notify("اختر هدفاً أولاً") return end
	local r, h = myRoot(), myHum()
	if not (r and rootOf(t) and h) then return end
	local orig = r.CFrame
	local g = newGen("benx")
	task.spawn(function()
		for v = 1, 6 do
			if not alive("benx", g) then break end
			task.wait()
			h.Sit = true
			teleportTo(rootOf(t) or r, CFrame.new(0, 0, -v) * CFrame.Angles(-1.5, 0, 0))
		end
		for v = 6, 1, -1 do
			if not alive("benx", g) then break end
			task.wait()
			h.Sit = true
			teleportTo(rootOf(t) or r, CFrame.new(0, 0, -v) * CFrame.Angles(-1.5, 0, 0))
		end
		if alive("benx", g) then
			local rr = myRoot()
			if rr then rr.CFrame = orig end
		end
		stop("benx")
		h.Sit = false
	end)
end

local function suckStart()
	local t = targetPlayer()
	if not t or t == plr then notify("اختر هدفاً أولاً") return false end
	local g = newGen("suck")
	local steps = {1, 1.5, 2, 2.5, 3, 3.5, 4, 3.5, 3, 2.5, 2, 1.5, 1}
	task.spawn(function()
		while alive("suck", g) do
			local h = myHum()
			if not (h and rootOf(t)) then break end
			h.Sit = true
			for _, z in ipairs(steps) do
				if not alive("suck", g) then break end
				local tr, r = rootOf(t), myRoot()
				if tr and r then
					r.CFrame = tr.CFrame * CFrame.new(0, -2, 0) * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, 0, z)
				end
				task.wait()
			end
		end
	end)
	return true
end

local function followStart(key, mode)
	local t = targetPlayer()
	if not t or t == plr then notify("اختر هدفاً أولاً") return false end
	local g = newGen(key)
	local h = myHum()
	if h then h.Sit = true end
	conns[key] = RunService.Stepped:Connect(function()
		if not alive(key, g) then return end
		local hd = char(t) and char(t):FindFirstChild("Head")
		local r, hh = myRoot(), myHum()
		if hd and r and hh then
			if not hh.Sit then hh.Sit = true end
			if mode == "head" then
				r.CFrame = hd.CFrame * CFrame.new(0, 1, 0.4)
			else
				r.CFrame = hd.CFrame * CFrame.new(0, 0, -1) * CFrame.Angles(0, math.pi, 0)
			end
			r.Velocity = Vector3.zero
		end
	end)
	return true
end

local function followStop(key)
	stop(key)
	if conns[key] then conns[key]:Disconnect(); conns[key] = nil end
	stopHumanoidFlags()
end

