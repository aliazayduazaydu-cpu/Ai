		set(a.idle.Animation2, ids[2])
		set(a.walk.WalkAnim, ids[3])
		set(a.run.RunAnim, ids[4])
		set(a.jump.JumpAnim, ids[5])
		set(a.climb.ClimbAnim, ids[6])
		set(a.fall.FallAnim, ids[7])
		h:ChangeState(3)
	end)
	a.Disabled = false
end

