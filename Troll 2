local function showPage(page)
	for _, p in ipairs(pages) do p.Visible = (p == page) end
end

local function makeSection(text)
	local page = Instance.new("ScrollingFrame")
	page.Name = text
	page.Position = UDim2.new(0, 105, 0, 30)
	page.Size = UDim2.new(1, -105, 1, -30)
	page.BackgroundTransparency = 1
	page.BorderSizePixel = 0
	page.ScrollBarThickness = 4
	page.AutomaticCanvasSize = Enum.AutomaticSize.Y
	page.CanvasSize = UDim2.new(0, 0, 0, 0)
	page.Visible = false
	page.Parent = main
	local l = Instance.new("UIListLayout", page)
	l.Padding = UDim.new(0, 6)
	l.HorizontalAlignment = Enum.HorizontalAlignment.Center

	local tab = Instance.new("TextButton")
	tab.Size = UDim2.new(1, -12, 0, 30)
	tab.BackgroundColor3 = Color3.fromRGB(70, 10, 10)
	tab.BackgroundTransparency = 0.5
	tab.BorderSizePixel = 0
	tab.Text = text
	tab.TextColor3 = Color3.fromRGB(255, 255, 255)
	tab.Font = Enum.Font.Oswald
	tab.TextScaled = true
	tab.Parent = sidebar
	Instance.new("UICorner", tab).CornerRadius = UDim.new(0, 8)
	tab.MouseButton1Click:Connect(function() showPage(page) end)

	table.insert(pages, page)
	return page
end

local function addButton(page, text, cb)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.95, 0, 0, 32)
	b.BackgroundColor3 = Color3.fromRGB(70, 10, 10)
	b.BackgroundTransparency = 0.5
	b.BorderSizePixel = 0
	b.Text = text
	b.TextColor3 = Color3.fromRGB(255, 255, 255)
	b.Font = Enum.Font.Oswald
	b.TextScaled = true
	b.Parent = page
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	if cb then b.MouseButton1Click:Connect(cb) end
	return b
end

-- زر تشغيل/إيقاف بمؤشر لون. persist = لا يُطفأ عند إعادة الإحياء
local function addToggle(page, text, cb, persist)
	local state = false
	local b = addButton(page, text)
	local led = Instance.new("Frame")
	led.Size = UDim2.new(0, 10, 0, 10)
	led.Position = UDim2.new(1, -18, 0.5, -5)
	led.BorderSizePixel = 0
	led.Parent = b
	Instance.new("UICorner", led).CornerRadius = UDim.new(1, 0)
	local function set(v, silent)
		state = v
		led.BackgroundColor3 = v and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
		if not silent and cb then cb(v) end
	end
	set(false, true)
	b.MouseButton1Click:Connect(function() set(not state) end)
	if not persist then table.insert(resetters, function() set(false) end) end
	return set
end

local function addInput(page, placeholder, cb)
	local t = Instance.new("TextBox")
	t.Size = UDim2.new(0.95, 0, 0, 32)
	t.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	t.BackgroundTransparency = 0.5
	t.BorderSizePixel = 0
	t.PlaceholderText = placeholder
	t.Text = ""
	t.TextColor3 = Color3.fromRGB(255, 255, 255)
	t.Font = Enum.Font.Oswald
	t.TextScaled = true
	t.Parent = page
	Instance.new("UICorner", t).CornerRadius = UDim.new(0, 8)
	t.FocusLost:Connect(function() cb(t.Text, tonumber(t.Text)) end)
	return t
end

local function addLabel(page, text, h)
	local l = Instance.new("TextLabel")
	l.Size = UDim2.new(0.95, 0, 0, h or 30)
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = Color3.fromRGB(255, 255, 255)
	l.Font = Enum.Font.Oswald
	l.TextScaled = true
	l.Parent = page
	return l
end

local function giveTool(name, texture, onActivate)
	local bp = plr.Backpack
	for _, x in ipairs({bp:FindFirstChild(name), plr.Character and plr.Character:FindFirstChild(name)}) do
		if x then x:Destroy() end
	end
	local tool = Instance.new("Tool")
	tool.Name = name
	tool.RequiresHandle = false
	tool.TextureId = texture
	tool.Parent = bp
	tool.Activated:Connect(function() onActivate() end)
end

local function playerFromPart(part)
	local p = part
	while p and not p:FindFirstChildOfClass("Humanoid") do p = p.Parent end
	return p and Players:GetPlayerFromCharacter(p)
end

local function targetNotify(p)
	targetName = p.Name
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Target : " .. p.DisplayName,
			Text = "",
			Icon = "rbxthumb://type=AvatarHeadShot&id=" .. p.UserId .. "&w=420&h=420",
			Duration = 5,
		})
	end)
end

