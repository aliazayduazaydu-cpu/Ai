local STAND = {
	jojo = {id = "13823324057", t = 10},
	Sit = {id = "12507085924", t = 7},
	Aura = {id = "10478338114", t = 1.5},
	zby = {id = "10214311282", t = 3},
}
local STAND_OFFSET = {
	Bottom = CFrame.new(0, 4, 2),
	Left = CFrame.new(-3, 4, 2),
	Right = CFrame.new(3, 5, 2),
}
local standTrack = nil

local function standOff()
	stop("stand")
	if standTrack then standTrack:Stop(); standTrack = nil end
	local a = plr.Character and plr.Character:FindFirstChild("Animate")
	if a then a.Disabled = false end
end

local function standStart(key, side)
	standOff()
	local t = targetPlayer()
	if not t or t == plr then notify("اختر هدفاً أولاً") return false end
	local h = myHum()
	if not h then return false end
	local info = STAND[key]
	local g = newGen("stand")
	local anim = Instance.new("Animation")
	anim.AnimationId = "rbxassetid://" .. info.id
	standTrack = h:LoadAnimation(anim)
	standTrack:AdjustSpeed(0.1)
	standTrack:Play()
	local off = STAND_OFFSET[side]
	task.spawn(function()
		while alive("stand", g) do
			local r, tr = myRoot(), rootOf(t)
			if not (r and tr and t.Parent) then break end
			r.Velocity = Vector3.zero
			if standTrack then standTrack.TimePosition = info.t end
			r.CFrame = tr.CFrame * off
			task.wait()
		end
		if alive("stand", g) then standOff() end
	end)
	return true
end

