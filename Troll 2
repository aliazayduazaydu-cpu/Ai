local function noclipStart()
	conns.noclip = RunService.Stepped:Connect(function()
		local c = plr.Character
		if not c then return end
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then d.CanCollide = false end
		end
	end)
end

local function noclipStop()
	if conns.noclip then conns.noclip:Disconnect(); conns.noclip = nil end
	local c = plr.Character
	if c then
		for _, d in ipairs(c:GetDescendants()) do
			if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" then d.CanCollide = true end
		end
	end
end

local flyBV, flyGyro
local function flyStop()
	if conns.fly then conns.fly:Disconnect(); conns.fly = nil end
	if flyBV then flyBV:Destroy(); flyBV = nil end
	if flyGyro then flyGyro:Destroy(); flyGyro = nil end
	stopHumanoidFlags()
end

local function flyStart()
	local r, h = myRoot(), myHum()
	if not (r and h) then return false end
	flyStop()
	flyBV = Instance.new("BodyVelocity")
	flyBV.MaxForce = Vector3.new(1e5, 1e5, 1e5)
	flyBV.Velocity = Vector3.zero
	flyBV.Parent = r
	flyGyro = Instance.new("BodyGyro")
	flyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
	flyGyro.CFrame = r.CFrame
	flyGyro.Parent = r
	h.PlatformStand = true
	conns.fly = RunService.RenderStepped:Connect(function()
		local r2, h2 = myRoot(), myHum()
		if not (r2 and h2 and flyBV and flyGyro) then return end
		local v = h2.MoveDirection * flySpeed
		if h2.Jump or UIS:IsKeyDown(Enum.KeyCode.Space) then v = v + Vector3.new(0, flySpeed, 0) end
		if UIS:IsKeyDown(Enum.KeyCode.Q) or UIS:IsKeyDown(Enum.KeyCode.LeftControl) then
			v = v - Vector3.new(0, flySpeed, 0)
		end
		flyBV.Velocity = v
		flyGyro.CFrame = cam.CFrame
	end)
	return true
end

