local function serverHop()
	local ok, body = pcall(function()
		local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", game.PlaceId)
		local raw = httprequest and httprequest({Url = url}).Body or game:HttpGetAsync(url)
		return HttpService:JSONDecode(raw)
	end)
	if not ok or not body or not body.data then
		notify("فشل جلب السيرفرات")
		return
	end
	local list = {}
	for _, s in ipairs(body.data) do
		if s.playing < s.maxPlayers and s.id ~= game.JobId then table.insert(list, s.id) end
	end
	if #list > 0 then
		TeleportService:TeleportToPlaceInstance(game.PlaceId, list[math.random(#list)], plr)
	end
end

