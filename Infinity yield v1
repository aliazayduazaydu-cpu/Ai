-- ==========================================================
-- SHOW THE 10 COMMANDS IN THE LIST
-- ==========================================================
for _, name in ipairs({"jobid", "notifyjobid", "breakloops", "gametp", "clearerror",
	"cancelteleport", "volume", "notify", "screenshot", "rec"}) do
