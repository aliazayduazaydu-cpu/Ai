-- ==========================================================
-- EXAMPLES: how to add a button and a toggle
-- ==========================================================
addButton("Example Button", function()
	notify("Button", "You pressed the button")
end)

addToggle("Example Toggle",
	function() notify("Toggle", "ON") end,   -- runs when turned ON
	function() notify("Toggle", "OFF") end   -- runs when turned OFF
)

