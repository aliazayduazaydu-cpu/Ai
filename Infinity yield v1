layout.Parent = scroll

cmdBar.FocusLost:Connect(function(enterPressed)
	if enterPressed and cmdBar.Text ~= "" then
		execCmd(cmdBar.Text)
		cmdBar.Text = ""
	end
end)

-- Makes one row in the list (used by buttons and toggles)
local function makeRow(text)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -6, 0, 30)
	b.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	b.BorderSizePixel = 0
	b.TextColor3 = Color3.new(1, 1, 1)
	b.Font = Enum.Font.SourceSans
	b.TextSize = 16
	b.Text = text
	b.AutoButtonColor = true
	b.Parent = scroll
	return b
end

-- ==========================================================
-- 2) BUTTON SYSTEM
-- ==========================================================
function addButton(text, func)
	local b = makeRow(text)
	b.MouseButton1Click:Connect(function()
		local ok, err = pcall(func)
		if not ok then notify("Error", tostring(err)) end
	end)
	return b
end

-- A button that runs a command from the cmd list
function addCmdButton(cmdText)
	return addButton(cmdText, function()
		execCmd(cmdText)
	end)
end

-- ==========================================================
-- 3) TOGGLE SYSTEM
-- ==========================================================
function addToggle(text, onFunc, offFunc, default)
	local state = default or false
	local b = makeRow(text .. ": " .. (state and "ON" or "OFF"))
	b.BackgroundColor3 = state and Color3.fromRGB(40, 110, 60) or Color3.fromRGB(50, 50, 50)

	b.MouseButton1Click:Connect(function()
		state = not state
		b.Text = text .. ": " .. (state and "ON" or "OFF")
		b.BackgroundColor3 = state and Color3.fromRGB(40, 110, 60) or Color3.fromRGB(50, 50, 50)
		local f = state and onFunc or offFunc
		if f then
			local ok, err = pcall(f)
			if not ok then notify("Error", tostring(err)) end
		end
	end)
	return b
end

