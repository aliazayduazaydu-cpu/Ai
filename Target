    local tRoot = t.Character:FindFirstChild("HumanoidRootPart")
    local myRoot = GetRoot(plr)
    if not (tRoot and myRoot) then return end
    local startPos = tRoot.Position
    local goalPos = myRoot.Position
    local dir = goalPos - startPos
    local dist = dir.Magnitude
    if dist < 1 then return end
    dir = dir.Unit
    for i = 1, 30 do
        if not tRoot.Parent then break end
        tRoot.CFrame = CFrame.new(startPos + dir * (dist * i / 30) + Vector3.new(0, 2, 0))
        RunService.Heartbeat:Wait()
    end
    SendNotify("Ali Hub","Brought "..t.Name,4)
end)

