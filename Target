-- FLY SYSTEM
local flying = false
local flyConn, flyBV, flyBG
local flyVel = Vector3.new()
local flyUp, flyDown = false, false

local function StopFly()
    flying = false
    if flyConn then flyConn:Disconnect() flyConn = nil end
    if flyBV then flyBV:Destroy() flyBV = nil end
    if flyBG then flyBG:Destroy() flyBG = nil end
    flyVel = Vector3.new()
    pcall(function() plr.Character.Humanoid.PlatformStand = false end)
end

local function StartFly()
    local char = plr.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return end
    StopFly()
    flying = true
    hum.PlatformStand = true
    flyBV = Instance.new("BodyVelocity")
    flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
    flyBV.Velocity = Vector3.new()
    flyBV.Parent = root
    flyBG = Instance.new("BodyGyro")
    flyBG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
    flyBG.P = 9e4
    flyBG.CFrame = root.CFrame
    flyBG.Parent = root
    flyConn = RunService.Heartbeat:Connect(function(dt)
        if not flying or not root.Parent or not hum.Parent then
            StopFly() return
        end
        local cam = workspace.CurrentCamera
        local look = cam.CFrame.LookVector
        local right = cam.CFrame.RightVector
        local flatLook = Vector3.new(look.X, 0, look.Z)
        local flatRight = Vector3.new(right.X, 0, right.Z)
        if flatLook.Magnitude > 0 then flatLook = flatLook.Unit end
        if flatRight.Magnitude > 0 then flatRight = flatRight.Unit end
        local md = hum.MoveDirection
        local fwd = md:Dot(flatLook)
        local side = md:Dot(flatRight)
        local dir = flatLook * fwd + flatRight * side + Vector3.new(0, look.Y * fwd, 0)
        if hum.Jump or flyUp then dir = dir + Vector3.new(0, 1, 0) end
        if flyDown then dir = dir - Vector3.new(0, 1, 0) end
        local target = Vector3.new()
        if dir.Magnitude > 0.05 then target = dir.Unit * FlySpeed end
        flyVel = flyVel:Lerp(target, math.clamp(dt * 8, 0, 1))
        flyBV.Velocity = flyVel
        if flatLook.Magnitude > 0 then
            flyBG.CFrame = CFrame.lookAt(root.Position, root.Position + flatLook)
        end
    end)
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Space then flyUp = true end
    if input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.LeftControl then flyDown = true end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.KeyCode == Enum.KeyCode.Space then flyUp = false end
    if input.KeyCode == Enum.KeyCode.Q or input.KeyCode == Enum.KeyCode.LeftControl then flyDown = false end
end)

