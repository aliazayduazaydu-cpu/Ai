-- WELD SYSTEM
local weldActive = false
local weldConn = nil
local currentWeldBtn = nil

local function StopWeld()
    weldActive = false
    if weldConn then weldConn:Disconnect() weldConn = nil end
    pcall(function()
        local root = GetRoot(plr)
        if root then sethiddenproperty(root, "PhysicsRepRootRef", nil) end
    end)
    local hum = plr.Character and plr.Character:FindFirstChild("Humanoid")
    if hum then hum.PlatformStand = false end
    if currentWeldBtn then
        currentWeldBtn.Ticket_Asset.ImageColor3 = Color3.fromRGB(255, 0, 0)
        currentWeldBtn = nil
    end
end

local function StartWeld(btn, offset, rot)
    if weldActive and currentWeldBtn == btn then
        StopWeld()
        return
    end
    StopWeld()
    local t = GetTarget()
    if not t or not t.Character then SendNotify("Ali Hub","No target!",4) return end
    weldActive = true
    currentWeldBtn = btn
    btn.Ticket_Asset.ImageColor3 = Color3.fromRGB(0, 255, 0)
    local hum = plr.Character and plr.Character:FindFirstChild("Humanoid")
    if hum then hum.PlatformStand = true end
    weldConn = RunService.Heartbeat:Connect(function()
        local target = GetTarget()
        local tRoot = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart")
        local myRoot = GetRoot(plr)
        if tRoot and myRoot then
            myRoot.CFrame = tRoot.CFrame * CFrame.new(offset) * (rot or CFrame.new())
            myRoot.Velocity = Vector3.zero
            pcall(function()
                sethiddenproperty(myRoot, "PhysicsRepRootRef", InstanceHandle.new(tRoot))
            end)
        end
    end)
end

