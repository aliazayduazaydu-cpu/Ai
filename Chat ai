local function SetFullBright(Value)

    GraphicsSettings.FullBright = Value

    if Value then

        Lighting.Brightness = 3
        Lighting.Ambient = Color3.fromRGB(255, 255, 255)
        Lighting.OutdoorAmbient = Color3.fromRGB(255, 255, 255)
        Lighting.ExposureCompensation = 0.5

    else

        Lighting.Brightness = OriginalGraphics.Brightness
        Lighting.Ambient = OriginalGraphics.Ambient
        Lighting.OutdoorAmbient = OriginalGraphics.OutdoorAmbient
        Lighting.ExposureCompensation =
            OriginalGraphics.ExposureCompensation

    end

end

local function SetNightMode(Value)

    GraphicsSettings.NightMode = Value

    if Value then
        Lighting.ClockTime = 0
    else
        Lighting.ClockTime = OriginalGraphics.ClockTime
    end

end

local function SetNoFog(Value)

    GraphicsSettings.NoFog = Value

    if Value then
        Lighting.FogEnd = 100000
        Lighting.FogStart = 0
    else
        Lighting.FogEnd = OriginalGraphics.FogEnd
        Lighting.FogStart = OriginalGraphics.FogStart
    end

end

local function SetShadows(Value)

    GraphicsSettings.Shadows = Value

    Lighting.GlobalShadows = Value

end

local function SetBloom(Value)

    GraphicsSettings.Bloom = Value

    Bloom.Enabled = Value

end

local function SetColorCorrection(Value)

    GraphicsSettings.ColorCorrection = Value

    ColorEffect.Enabled = Value

    if Value then

        ColorEffect.Brightness = 0.05
        ColorEffect.Contrast = 0.15
        ColorEffect.Saturation = 0.2

    else

        ColorEffect.Brightness = 0
        ColorEffect.Contrast = 0
        ColorEffect.Saturation = 0

    end

end

