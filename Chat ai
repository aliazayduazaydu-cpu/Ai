local function StartPlayerSpectate()

    if not PMTarget then
        PMStatusLabel.Text = "Select a player first"
        return
    end

    local Character = PMTarget.Character

    local Humanoid = Character and
        Character:FindFirstChildOfClass("Humanoid")

    local Camera = workspace.CurrentCamera

    if not Humanoid or not Camera then
        PMStatusLabel.Text = "Target character unavailable"
        return
    end

    if not PMOriginalCameraSubject then

        local OwnCharacter = Player.Character

        PMOriginalCameraSubject =
            OwnCharacter and
            OwnCharacter:FindFirstChildOfClass("Humanoid")
            or Camera.CameraSubject

    end

    Camera.CameraSubject = Humanoid

    PMStatusLabel.Text =
        "Spectating: " .. PMTarget.Name

end

local function StopPlayerSpectate()

    local Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    local OwnCharacter = Player.Character

    local OwnHumanoid = OwnCharacter and
        OwnCharacter:FindFirstChildOfClass("Humanoid")

    Camera.CameraSubject =
        OwnHumanoid or PMOriginalCameraSubject

    PMOriginalCameraSubject = nil

    PMStatusLabel.Text = "Spectate stopped"

end

