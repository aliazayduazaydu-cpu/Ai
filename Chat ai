--==================================================
-- SYSTEM CHECK
--==================================================

local function CheckSystem(Name, Condition)

    local Status = Condition and "READY" or "MISSING"

    print(
        "[ALAWI CHECK]",
        Name,
        Status
    )

    return Name .. ": " .. Status

end

local function RunSystemCheck()

    local Results = {}

    table.insert(
        Results,
        CheckSystem(
            "Main GUI",
            Screen ~= nil and Screen.Parent ~= nil
        )
    )

    table.insert(
        Results,
        CheckSystem(
            "Player",
            Player ~= nil and Player.Parent ~= nil
        )
    )

    table.insert(
        Results,
        CheckSystem(
            "Character",
            GetCharacter() ~= nil
        )
    )

    table.insert(
        Results,
        CheckSystem(
            "Movement System",
            MovementSettings ~= nil
        )
    )

    table.insert(
        Results,
        CheckSystem(
            "ESP System",
            ESPSettings ~= nil
        )
    )

    table.insert(
        Results,
        CheckSystem(
            "Builder System",
            BuilderObjects ~= nil
        )
    )

    table.insert(
        Results,
        CheckSystem(
            "Automation System",
            AutomationSettings ~= nil
        )
    )

    table.insert(
        Results,
        CheckSystem(
            "Configuration System",
            ConfigRemote ~= nil
        )
    )

    local Camera = workspace.CurrentCamera

    table.insert(
        Results,
        CheckSystem(
            "Camera",
            Camera ~= nil
        )
    )

    FinalResults.Text =
        table.concat(Results, "\n")

    FinalStatus.Text =
        "System Check Completed"

end

AddButton(
    FinalTab,
    "Run Full System Check",
    function()

        local Success, Error = pcall(
            RunSystemCheck
        )

        if not Success then

            FinalStatus.Text =
                "Check Error: " .. tostring(Error)

        end

    end
)

