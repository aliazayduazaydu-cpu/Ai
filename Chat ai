-- إظهار وإخفاء أسماء اللاعبين محلياً
local NameTagsEnabled = false
local NameTags = {}

local function ClearNameTags()
    for _, gui in pairs(NameTags) do
        if gui then
            gui:Destroy()
        end
    end
    table.clear(NameTags)
end

local function UpdateNameTags()
    ClearNameTags()

    if not NameTagsEnabled then
        return
    end

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= Player and target.Character then
            local Head = target.Character:FindFirstChild("Head")

            if Head then
                local Billboard = Instance.new("BillboardGui")
                Billboard.Name = "AlawiNameTag"
                Billboard.Adornee = Head
                Billboard.Size = UDim2.fromOffset(150, 35)
                Billboard.StudsOffset = Vector3.new(0, 2, 0)
                Billboard.AlwaysOnTop = true
                Billboard.Parent = Player:WaitForChild("PlayerGui")

                local Label = Instance.new("TextLabel")
                Label.Size = UDim2.fromScale(1, 1)
                Label.BackgroundTransparency = 1
                Label.Text = target.DisplayName
                Label.TextColor3 = Color3.fromRGB(255, 255, 255)
                Label.TextStrokeTransparency = 0
                Label.TextScaled = true
                Label.Parent = Billboard

                table.insert(NameTags, Billboard)
            end
        end
    end
end

DisplayTab:AddToggle({
    Name = "أسماء اللاعبين",
    Default = false,
    Callback = function(Value)
        NameTagsEnabled = Value
        UpdateNameTags()
    end
})

DisplayTab:AddButton({
    Name = "تحديث الأسماء",
    Callback = function()
        UpdateNameTags()
    end
})

Players.PlayerAdded:Connect(function()
    task.wait(2)
    UpdateNameTags()
end)

Players.PlayerRemoving:Connect(function()
    task.wait(0.2)
    UpdateNameTags()
end)

