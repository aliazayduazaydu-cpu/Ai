local function FindPlayerByName(Name)

    if not Name or Name == "" then
        return nil
    end

    Name = string.lower(Name)

    for _, Target in ipairs(PMPlayers:GetPlayers()) do

        if string.lower(Target.Name) == Name then
            return Target
        end

        if string.sub(
            string.lower(Target.Name),
            1,
            #Name
        ) == Name then

            return Target

        end

        if string.sub(
            string.lower(Target.DisplayName),
            1,
            #Name
        ) == Name then

            return Target

        end

    end

    return nil

end

--==================================================
-- PLAYER INFORMATION
--==================================================

local function GetPlayerInformation(Target)

    if not Target then
        return "No player selected"
    end

    local Character = Target.Character

    local Humanoid = Character and
        Character:FindFirstChildOfClass("Humanoid")

    local Root = Character and
        Character:FindFirstChild("HumanoidRootPart")

    local TeamName = "No Team"

    if Target.Team then
        TeamName = Target.Team.Name
    end

    local Health = "Unknown"
    local MaxHealth = "Unknown"
    local Speed = "Unknown"
    local Jump = "Unknown"

    if Humanoid then

        Health = math.floor(Humanoid.Health)
        MaxHealth = math.floor(Humanoid.MaxHealth)

        Speed = Humanoid.WalkSpeed
        Jump = Humanoid.UseJumpPower
            and Humanoid.JumpPower
            or Humanoid.JumpHeight

    end

    local Position = "Unknown"

    if Root then

        Position = string.format(
            "%.1f, %.1f, %.1f",
            Root.Position.X,
            Root.Position.Y,
            Root.Position.Z
        )

    end

    return table.concat({

        "Username: " .. Target.Name,
        "Display Name: " .. Target.DisplayName,
        "User ID: " .. Target.UserId,
        "Account Age: " .. Target.AccountAge .. " Days",
        "Team: " .. TeamName,
        "Health: " .. Health .. "/" .. MaxHealth,
        "WalkSpeed: " .. Speed,
        "Jump: " .. Jump,
        "Position: " .. Position

    }, "\n")

end

local function RefreshPlayerInformation()

    if not PMTarget or not PMTarget.Parent then

        PMPlayerInfoLabel.Text =
            "Player Information: None"

        return

    end

    PMPlayerInfoLabel.Text =
        GetPlayerInformation(PMTarget)

end

