end)
addFeature(8,"تمييز الأجزاء القريبة","يحدد أقرب BasePart ضمن 25 studs.",function()
    local r=root(); if not r then return end
    local nearest,dist=nil,25
    for _,v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") and not v:IsDescendantOf(character()) then
            local d=(v.Position-r.Position).Magnitude
            if d<dist then nearest=v; dist=d end
        end
    end
    if nearest then
        local h=Instance.new("Highlight"); h.Name="ALI_NearPart"; h.Adornee=nearest; h.Parent=gui
        task.delay(5,function() if h then h:Destroy() end end)
        notify("تم تمييز: "..nearest.Name)
    else notify("لا يوجد جزء قريب") end
end)
addFeature(8,"إزالة تمييز الأجزاء","يحذف التمييز المؤقت.",function()
