--==================== المجموعة 6: الإضاءة والمؤثرات ====================
addFeature(6,"إضاءة كاملة تشغيل/إيقاف","يرفع إضاءة المشهد محلياً.",function()
    state.fullbright=not state.fullbright
    if state.fullbright then
        if not state.originalLighting then
            state.originalLighting={
                Brightness=Lighting.Brightness,
                ClockTime=Lighting.ClockTime,
                FogEnd=Lighting.FogEnd,
                GlobalShadows=Lighting.GlobalShadows,
                Ambient=Lighting.Ambient,
                OutdoorAmbient=Lighting.OutdoorAmbient
            }
        end
        Lighting.Brightness=3
        Lighting.ClockTime=14
        Lighting.FogEnd=100000
        Lighting.GlobalShadows=false
        Lighting.Ambient=Color3.fromRGB(180,180,180)
        Lighting.OutdoorAmbient=Color3.fromRGB(180,180,180)
    else
        local o=state.originalLighting
        if o then
            for k,v in pairs(o) do Lighting[k]=v end
        end
    end
end)
addFeature(6,"نهار","يضبط وقت الإضاءة إلى الظهر.",function() Lighting.ClockTime=12 end)
addFeature(6,"غروب","يضبط وقت الإضاءة إلى الغروب.",function() Lighting.ClockTime=18 end)
addFeature(6,"ليل","يضبط وقت الإضاءة إلى منتصف الليل.",function() Lighting.ClockTime=0 end)
addFeature(6,"ضباب كثيف","يقلل FogEnd محلياً.",function() Lighting.FogEnd=100 end)
addFeature(6,"إزالة الضباب","يجعل FogEnd بعيداً جداً.",function() Lighting.FogEnd=100000 end)
addFeature(6,"ظلال تشغيل/إيقاف","يبدل GlobalShadows.",function() Lighting.GlobalShadows=not Lighting.GlobalShadows end)
addFeature(6,"تأثير Blur","يضيف أو يزيل BlurEffect.",function()
