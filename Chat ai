local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

-- 1: عرض FPS
local FPS = 0
local Frames = 0
local LastUpdate = os.clock()

RunService.RenderStepped:Connect(function()
    Frames += 1
    local Now = os.clock()

    if Now - LastUpdate >= 1 then
        FPS = Frames
        Frames = 0
        LastUpdate = Now
    end
end)

PerformanceTab:AddButton({
    Name = "عرض FPS",
    Callback = function()
        print("FPS:", FPS)
    end
})

