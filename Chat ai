local ESPTab = CreateTab("ESP", "👁")

AddLabel(ESPTab, "PLAYER ESP SETTINGS")

local function RemoveESP(PlayerObject)

    local Data = ESPObjects[PlayerObject]

    if not Data then
        return
    end

    if Data.Highlight then
        Data.Highlight:Destroy()
    end

    if Data.Billboard then
        Data.Billboard:Destroy()
    end

    ESPObjects[PlayerObject] = nil

end

local function CreateESP(PlayerObject)

    if PlayerObject == Player then
        return
    end

    local Character = PlayerObject.Character

    if not Character then
        return
    end

    local Root = Character:FindFirstChild(
        "HumanoidRootPart"
    )

    if not Root then
        return
    end

    RemoveESP(PlayerObject)

    local Highlight = Instance.new("Highlight")

    Highlight.Name = "AlawiESP"
    Highlight.Adornee = Character
    Highlight.FillTransparency = 0.75
    Highlight.OutlineTransparency = 0
    Highlight.DepthMode = Enum.HighlightDepthMode.Occluded

    if ESPSettings.TeamColors
    and PlayerObject.Team
    and Player.Team == PlayerObject.Team then

        Highlight.FillColor = Color3.fromRGB(50, 180, 255)
        Highlight.OutlineColor = Color3.fromRGB(50, 180, 255)

    else

        Highlight.FillColor = Color3.fromRGB(220, 50, 70)
        Highlight.OutlineColor = Color3.fromRGB(255, 255, 255)

    end

    Highlight.Parent = Character

    local Billboard = Instance.new("BillboardGui")

    Billboard.Name = "AlawiESPInfo"
    Billboard.Adornee = Root
    Billboard.Size = UDim2.fromOffset(180, 40)
    Billboard.StudsOffset = Vector3.new(0, 3, 0)
    Billboard.AlwaysOnTop = false
    Billboard.Parent = Root

    local Text = Instance.new("TextLabel")

    Text.Name = "Info"
    Text.Size = UDim2.fromScale(1, 1)
    Text.BackgroundTransparency = 1
    Text.TextColor3 = Color3.new(1, 1, 1)
    Text.TextStrokeTransparency = 0.2
    Text.Font = Enum.Font.GothamBold
    Text.TextSize = 12
    Text.Parent = Billboard

    ESPObjects[PlayerObject] = {
        Highlight = Highlight,
        Billboard = Billboard,
        Text = Text
    }

end

local function UpdateESP()

    if not ESPSettings.Enabled then
        return
    end

    local MyCharacter = Player.Character

    if not MyCharacter then
        return
    end

    local MyRoot = MyCharacter:FindFirstChild(
        "HumanoidRootPart"
    )

    if not MyRoot then
        return
    end

    for _, Target in ipairs(Players:GetPlayers()) do

        if Target == Player then
            continue
        end

        local Character = Target.Character

        local Root = Character
            and Character:FindFirstChild("HumanoidRootPart")

        if not Root then
            RemoveESP(Target)
            continue
        end

        local Distance = (
            MyRoot.Position - Root.Position
        ).Magnitude

        if Distance > ESPSettings.MaxDistance then
            RemoveESP(Target)
            continue
        end

        if not ESPObjects[Target] then
            CreateESP(Target)
        end

        local Data = ESPObjects[Target]

        if Data then

            local NameText = ""

            if ESPSettings.ShowNames then
                NameText = Target.DisplayName
            end

            if ESPSettings.ShowDistance then

                if NameText ~= "" then
                    NameText = NameText .. " | "
                end

                NameText = NameText ..
                    math.floor(Distance) .. "m"

            end

            Data.Text.Text = NameText

        end

    end

end

