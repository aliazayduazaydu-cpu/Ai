local ESPTab = Window:MakeTab({"ESP", "eye"})

ESPTab:AddSection({"Player ESP"})

local function ClearESP()
    for _, obj in pairs(ESPObjects) do
        if obj then
            obj:Destroy()
        end
    end
    table.clear(ESPObjects)
end

local function RefreshESP()
    ClearESP()

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            local highlight = Instance.new("Highlight")
            highlight.Name = "AlawiESP"
            highlight.FillColor = Color3.fromRGB(255, 0, 0)
            highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
            highlight.FillTransparency = 0.65
            highlight.Parent = p.Character

            ESPObjects[p] = highlight
        end
    end
end

ESPTab:AddToggle({
    Name = "Player Highlight ESP",
    Default = false,
    Callback = function(v)
        ESPEnabled = v
        if v then
            RefreshESP()
        else
            ClearESP()
        end
    end
})

ESPTab:AddButton({
    Name = "Refresh ESP",
    Callback = function()
        if ESPEnabled then
            RefreshESP()
        end
    end
})

ESPTab:AddButton({
    Name = "Clear ESP",
    Callback = function()
        ClearESP()
        ESPEnabled = false
    end
})

ESPTab:AddDropdown({
    Name = "لون ESP",
    Options = {"Red", "Green", "Blue", "Purple", "White"},
    Default = "Red",
    Callback = function(v)
        local colors = {
            Red = Color3.fromRGB(255, 0, 0),
            Green = Color3.fromRGB(0, 255, 0),
            Blue = Color3.fromRGB(0, 100, 255),
            Purple = Color3.fromRGB(170, 0, 255),
            White = Color3.fromRGB(255, 255, 255)
        }

        for _, obj in pairs(ESPObjects) do
            if obj then
                obj.FillColor = colors[v]
            end
        end
    end
})

