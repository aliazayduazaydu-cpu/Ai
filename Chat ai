--==================================================
-- CLEANUP
--==================================================

local function CleanupExtraSystems()

    -- Stop RGB
    if RGBConnection then

        RGBConnection:Disconnect()

        RGBConnection = nil

    end

    -- Stop FPS counter
    if FPSConnection then

        FPSConnection:Disconnect()

        FPSConnection = nil

    end

    -- Stop automation loop
    if AutomationSettings then

        AutomationRunning = false

    end

    -- Restore camera
    if workspace.CurrentCamera then

        local Humanoid = GetHumanoid()

        if Humanoid then

            workspace.CurrentCamera.CameraSubject =
                Humanoid

            workspace.CurrentCamera.CameraType =
                Enum.CameraType.Custom

        end

    end

    print("ALAWI MEGA HUB CLEANUP COMPLETE")

end

AddButton(
    FinalTab,
    "Stop Extra Systems",
    function()

        CleanupExtraSystems()

        FinalStatus.Text =
            "Extra systems stopped"

    end
)

