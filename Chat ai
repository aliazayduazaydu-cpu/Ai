--==================================================
-- WORLD COUNTER
--==================================================

local WorldCountLabel = AddLabel(
    ExtraTab,
    "Workspace Objects: Calculating..."
)

local function UpdateWorldCount()

    local Objects = workspace:GetDescendants()

    local Parts = 0
    local Models = 0
    local Tools = 0

    for _, Object in ipairs(Objects) do

        if Object:IsA("BasePart") then

            Parts += 1

        elseif Object:IsA("Model") then

            Models += 1

        elseif Object:IsA("Tool") then

            Tools += 1

        end

    end

    WorldCountLabel.Text = table.concat({

        "Workspace Objects: " .. #Objects,
        "Parts: " .. Parts,
        "Models: " .. Models,
        "Tools: " .. Tools

    }, "\n")

end

AddToggle(
    ExtraTab,
    "World Counter",
    true,
    function(Value)

        ExtraSettings.WorldCount = Value

        WorldCountLabel.Visible = Value

    end
)

--==================================================
-- CAMERA INFORMATION
--==================================================

local CameraInfoLabel = AddLabel(
    ExtraTab,
    "Camera Information"
)

local function UpdateCameraInformation()

    local Camera = workspace.CurrentCamera

    if not Camera then
        return
    end

    CameraInfoLabel.Text = table.concat({

        "Camera FOV: " .. math.floor(Camera.FieldOfView),

        "Camera Type: " .. tostring(Camera.CameraType),

        "Viewport: " ..
            tostring(Camera.ViewportSize)

    }, "\n")

end

--==================================================
-- REFRESH BUTTON
--==================================================

AddButton(
    ExtraTab,
    "Refresh All Information",
    function()

        UpdatePing()
        UpdateClock()
        UpdateHealth()
        UpdatePosition()
        UpdateWalkSpeed()
        UpdateWorldCount()
        UpdateCameraInformation()

        ExtraStatus.Text = "Information refreshed"

    end
)

--==================================================
-- UPDATE LOOP
--==================================================

task.spawn(function()

    while Screen.Parent do

        task.wait(1)

        if ExtraSettings.Ping then
            UpdatePing()
        end

        if ExtraSettings.Clock then
            UpdateClock()
        end

        if ExtraSettings.Health then
            UpdateHealth()
        end

        if ExtraSettings.Position then
            UpdatePosition()
        end

        UpdateWalkSpeed()

        if ExtraSettings.WorldCount then
            UpdateWorldCount()
        end

        UpdateCameraInformation()

    end

end)

--==================================================
-- INITIAL UPDATE
--==================================================

UpdatePing()
UpdateClock()
UpdateHealth()
UpdatePosition()
UpdateWalkSpeed()
UpdateWorldCount()
UpdateCameraInformation()

print("ALAWI MEGA HUB PART 13 LOADED")

