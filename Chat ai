--==================================================
-- HEALTH MONITOR
--==================================================

local HealthLabel = AddLabel(
    ExtraTab,
    "Health: Unknown"
)

local function UpdateHealth()

    local Humanoid = GetHumanoid()

    if not Humanoid then

        HealthLabel.Text = "Health: Unavailable"

        return

    end

    HealthLabel.Text =
