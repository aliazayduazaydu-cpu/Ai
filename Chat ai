addFeature(1,"الطيران تشغيل/إيقاف","طيران محلي بتحكم WASD واللمس.",function()
    state.fly=not state.fly
    local r=root()
    if not r then return end
    if state.fly then
        local att=Instance.new("Attachment"); att.Name="ALI_FlyAttachment"; att.Parent=r
        local lv=Instance.new("LinearVelocity"); lv.Name="ALI_FlyVelocity"
        lv.Attachment0=att; lv.MaxForce=1e6; lv.VectorVelocity=Vector3.zero
        lv.RelativeTo=Enum.ActuatorRelativeTo.World; lv.Parent=r
        local ao=Instance.new("AlignOrientation"); ao.Name="ALI_FlyOrientation"
        ao.Attachment0=att; ao.MaxTorque=1e6; ao.Responsiveness=15; ao.Parent=r
        connections.fly=RunService.RenderStepped:Connect(function()
            local c=character(); local hrp=root()
            if not c or not hrp or not state.fly then return end
            local move=humanoid() and humanoid().MoveDirection or Vector3.zero
            local vertical=0
            if UIS:IsKeyDown(Enum.KeyCode.Space) then vertical=1 end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then vertical=-1 end
            lv.VectorVelocity=(move+Vector3.new(0,vertical,0))*state.flySpeed
            ao.CFrame=camera.CFrame
        end)
        notify("الطيران يعمل")
    else
        disconnect("fly")
        if r:FindFirstChild("ALI_FlyVelocity") then r.ALI_FlyVelocity:Destroy() end
        if r:FindFirstChild("ALI_FlyOrientation") then r.ALI_FlyOrientation:Destroy() end
        if r:FindFirstChild("ALI_FlyAttachment") then r.ALI_FlyAttachment:Destroy() end
        notify("تم إيقاف الطيران")
    end
end)
