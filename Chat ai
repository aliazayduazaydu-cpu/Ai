        math.floor(Humanoid.Health) ..
        "/" ..
        math.floor(Humanoid.MaxHealth)

end

AddToggle(
    ExtraTab,
    "Health Monitor",
    true,
    function(Value)

        ExtraSettings.Health = Value

        HealthLabel.Visible = Value

    end
)

--==================================================
-- POSITION MONITOR
--==================================================

local PositionLabel = AddLabel(
    ExtraTab,
    "Position: Unknown"
)

local CurrentPosition = nil

local function UpdatePosition()

    local Root = GetLocalRoot()

    if not Root then

        PositionLabel.Text = "Position: Unknown"

        return

    end

    CurrentPosition = Root.Position

    PositionLabel.Text = string.format(
        "Position: %.1f, %.1f, %.1f",
        CurrentPosition.X,
        CurrentPosition.Y,
        CurrentPosition.Z
    )

end

AddToggle(
    ExtraTab,
    "Position Monitor",
    true,
    function(Value)

        ExtraSettings.Position = Value

        PositionLabel.Visible = Value

    end
)

AddButton(
    ExtraTab,
    "Print Coordinates",
    function()

        UpdatePosition()

        if CurrentPosition then

            print(
                "Coordinates:",
                CurrentPosition
            )

        end

    end
)

AddButton(
    ExtraTab,
    "Copy Coordinates",
    function()

        UpdatePosition()

        if CurrentPosition then

            local Text = string.format(
                "%.2f, %.2f, %.2f",
                CurrentPosition.X,
                CurrentPosition.Y,
                CurrentPosition.Z
            )

            -- Clipboard APIs are not available
            -- in a normal Roblox LocalScript.

            ExtraStatus.Text =
                "Coordinates printed to Output"

            print(Text)

        end

    end
)

--==================================================
-- WALK SPEED MONITOR
--==================================================

local SpeedLabel = AddLabel(
    ExtraTab,
    "WalkSpeed: Unknown"
)

local function UpdateWalkSpeed()

    local Humanoid = GetHumanoid()

