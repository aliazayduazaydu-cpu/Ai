--==================================================
-- ALAWI MEGA HUB
-- PART 13 : EXTRA SYSTEMS
--==================================================

local ExtraTab = CreateTab("Extra Systems", "⚡")

local StatsService = game:GetService("Stats")
local HttpService = game:GetService("HttpService")
local UserInputService = game:GetService("UserInputService")

local ExtraSettings = {
    FPS = true,
    Ping = true,
    Clock = true,
    Health = true,
    Position = true,
    WorldCount = true
}

local ExtraStatus = AddLabel(
    ExtraTab,
    "Extra Systems: Ready"
)

--==================================================
-- FPS COUNTER
--==================================================

local FPSLabel = AddLabel(
    ExtraTab,
    "FPS: Calculating..."
)

local CurrentFPS = 0
local FrameCounter = 0
local FPSTimer = 0

local FPSConnection

FPSConnection = RunService.RenderStepped:Connect(
    function(DeltaTime)

        if not ExtraSettings.FPS then
            return
        end

        FrameCounter += 1
        FPSTimer += DeltaTime

        if FPSTimer >= 1 then

            CurrentFPS = FrameCounter

            FPSLabel.Text =
                "FPS: " .. CurrentFPS

            FrameCounter = 0
            FPSTimer = 0

        end

    end
)

AddToggle(
    ExtraTab,
    "FPS Counter",
    true,
    function(Value)

        ExtraSettings.FPS = Value

        FPSLabel.Visible = Value

    end
)

--==================================================
-- PING COUNTER
--==================================================

local PingLabel = AddLabel(
    ExtraTab,
    "Ping: Calculating..."
)

local function GetPing()

    local Success, Result = pcall(function()

        return StatsService.Network.ServerStatsItem[
            "Data Ping"
        ]:GetValue()

    end)

    if Success then
        return math.floor(Result)
    end

    return nil

end

local function UpdatePing()

    local Ping = GetPing()

    if Ping then

        PingLabel.Text =
            "Ping: " .. Ping .. " ms"

    else

        PingLabel.Text = "Ping: Unavailable"

    end

end

AddToggle(
    ExtraTab,
    "Ping Counter",
    true,
    function(Value)

        ExtraSettings.Ping = Value

        PingLabel.Visible = Value

    end
)

--==================================================
-- CLOCK
--==================================================

local ClockLabel = AddLabel(
    ExtraTab,
    "Time: --:--:--"
)

local function UpdateClock()

    ClockLabel.Text =
        "Time: " .. os.date("%H:%M:%S")

end

AddToggle(
    ExtraTab,
    "Clock",
    true,
