local function GetHumanoid()
    local Character = GetCharacter()

    if not Character then
        return nil
    end

    return Character:FindFirstChildOfClass("Humanoid")
end

local function ApplyMovement()
    local Humanoid = GetHumanoid()

    if not Humanoid then
        return
    end

    if MovementSettings.SprintEnabled then
        Humanoid.WalkSpeed = MovementSettings.SprintSpeed
    else
        Humanoid.WalkSpeed = MovementSettings.WalkSpeed
    end

    Humanoid.UseJumpPower = true
    Humanoid.JumpPower = MovementSettings.JumpPower
end

local function ResetMovement()
    MovementSettings.WalkSpeed = 16
    MovementSettings.JumpPower = 50
    MovementSettings.SprintSpeed = 28
    MovementSettings.SprintEnabled = false

    ApplyMovement()
end

