--==================== المجموعة 8: العالم والتفاعل ====================
addFeature(8,"إظهار أسماء الأجزاء","يعرض اسم الجزء الذي تشير إليه الكاميرا.",function()
    local ray= camera:ViewportPointToRay(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
    local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={character()}
    local hit=Workspace:Raycast(ray.Origin,ray.Direction*500,params)
    notify(hit and hit.Instance:GetFullName() or "لا يوجد جزء أمامك")
end)
addFeature(8,"فحص ما أمامك","يعرض اسم الجسم والمسافة التقريبية.",function()
    local ray=camera:ViewportPointToRay(camera.ViewportSize.X/2,camera.ViewportSize.Y/2)
    local params=RaycastParams.new(); params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={character()}
    local hit=Workspace:Raycast(ray.Origin,ray.Direction*500,params)
    if hit then notify(hit.Instance.Name.." | "..math.floor(hit.Distance).." studs") else notify("المسار فارغ") end
end)
addFeature(8,"إظهار نقطة التصويب","ينشئ علامة صغيرة بمنتصف الشاشة.",function()
    local m=gui:FindFirstChild("ALI_Crosshair")
    if m then m:Destroy() else
        m=Instance.new("TextLabel"); m.Name="ALI_Crosshair"; m.Size=UDim2.fromOffset(24,24)
        m.Position=UDim2.new(.5,-12,.5,-12); m.BackgroundTransparency=1
        m.Text="+"; m.TextColor3=Color3.new(1,1,1); m.TextSize=22; m.Parent=gui
    end
end)
addFeature(8,"إزالة نقطة التصويب","يحذف علامة منتصف الشاشة.",function()
