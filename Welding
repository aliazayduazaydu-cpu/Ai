		if Conn then Conn:Disconnect(); Conn = nil end
		local LRoot = GetRoot(plr)
		
		if not State then
			if LRoot then
				LRoot.Velocity = Vector3.zero
				attach(LRoot, LRoot)
			end
			return
		end
		
		Conn = RunService.Heartbeat:Connect(function()
			local CurrentLRoot = GetRoot(plr)
			local TargetPlr = Players:FindFirstChild(TargetedPlayer)
			local TRoot = GetRoot(TargetPlr)
			if CurrentLRoot and TRoot then
				CurrentLRoot.CFrame = TRoot.CFrame * CFrame.new(Offset)
				CurrentLRoot.Velocity = Vector3.zero
				attach(CurrentLRoot, TRoot)
			end
		end)
	end)
end

local function SetupWeldRocket(Btn, Speed)
	local Conn = nil
	
	Btn.MouseButton1Click:Connect(function()
		if TargetedPlayer == nil then
			SendNotify("Ali hub", "الرجاء اختيار هدف أولاً!", 3)
			return
		end
		
		ChangeToggleColor(Btn)
		local State = (Btn.Ticket_Asset.ImageColor3 == Color3.fromRGB(0,255,0))
		
		if Conn then Conn:Disconnect(); Conn = nil end
		if not State then return end
		
		local LRoot = GetRoot(plr)
		local TargetPlr = Players:FindFirstChild(TargetedPlayer)
		local TRoot = GetRoot(TargetPlr)
		if not (LRoot and TRoot) then
			Btn.Ticket_Asset.ImageColor3 = Color3.fromRGB(255,0,0)
			return
		end
		
		local SavedCF = LRoot.CFrame
		Conn = RunService.Heartbeat:Connect(function()
			if not TRoot.Parent then return end
			local Pos = TRoot.Position + Vector3.new(0, -3, 0)
			LRoot.CFrame = CFrame.new(Pos, Pos + Vector3.new(0, 1, 0))
			LRoot.Velocity = Vector3.new(0, Speed, 0)
			LRoot.RotVelocity = Vector3.zero
			attach(LRoot, TRoot)
		end)
		
		task.delay(0.2, function()
			if Conn then Conn:Disconnect(); Conn = nil end
			if LRoot then
				LRoot.CFrame = SavedCF
				LRoot.Velocity = Vector3.zero
				LRoot.RotVelocity = Vector3.zero
				attach(LRoot, LRoot)
			end
			Btn.Ticket_Asset.ImageColor3 = Color3.fromRGB(255,0,0)
		end)
	end)
end

