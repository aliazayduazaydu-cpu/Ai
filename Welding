-- Update Target Function
local function UpdateTarget(player)
	pcall(function()
		if player and table.find(ForceWhitelist,player.UserId) then
			SendNotify("Ali hub","لا يمكنك استهداف هذا اللاعب: @"..player.Name.." / "..player.DisplayName,5)
			player = nil
		end
	end)
	if (player ~= nil) then
		TargetedPlayer = player.Name
		TargetName_Input.Text = player.Name
		UserIDTargetLabel.Text = ("المعرف: "..player.UserId.."\nالاسم: "..player.DisplayName.."\nانضم: "..os.date("%d-%m-%Y", os.time()-player.AccountAge * 24 * 3600).." [يوم/شهر/سنة]")
		TargetImage.Image = Players:GetUserThumbnailAsync(player.UserId,Enum.ThumbnailType.HeadShot,Enum.ThumbnailSize.Size420x420)
	else
		TargetName_Input.Text = ""
		UserIDTargetLabel.Text = "المعرف: \nالاسم: \nانضم: "
		TargetImage.Image = "rbxassetid://10818605405"
		TargetedPlayer = nil
		for _, btn in ipairs(ToggleButtons) do
			local tAsset = btn:FindFirstChild("Ticket_Asset")
			if tAsset then
				tAsset.ImageColor3 = Color3.fromRGB(255,0,0)
			end
		end
	end
end

