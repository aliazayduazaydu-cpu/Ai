-- ==========================================
-- WELDING ABILITIES LINKED TO TARGET SYSTEM
-- ==========================================
local function SetupWeldMovement(Btn, Offset, IsFling)
	local Conn = nil
	local SavedCF = nil
	
	Btn.MouseButton1Click:Connect(function()
		if TargetedPlayer == nil then
			SendNotify("Ali hub", "الرجاء اختيار هدف أولاً!", 3)
			return
		end
		
		ChangeToggleColor(Btn)
		local State = (Btn.Ticket_Asset.ImageColor3 == Color3.fromRGB(0,255,0))
		
		if Conn then Conn:Disconnect(); Conn = nil end
		local LRoot = GetRoot(plr)
		
		if not State then
			if LRoot and SavedCF then
				LRoot.CFrame = SavedCF
				LRoot.Velocity = Vector3.zero
				LRoot.RotVelocity = Vector3.zero
				SavedCF = nil
			end
			if LRoot then attach(LRoot, LRoot) end
			return
		end
		
		if LRoot then SavedCF = LRoot.CFrame end
		
		Conn = RunService.Heartbeat:Connect(function()
			local CurrentLRoot = GetRoot(plr)
			local TargetPlr = Players:FindFirstChild(TargetedPlayer)
			local TRoot = GetRoot(TargetPlr)
			if not (CurrentLRoot and TRoot) then return end
			
			CurrentLRoot.CFrame = CFrame.new(TRoot.Position + Offset) * CFrame.Angles(-math.pi/2, 0, 0)
			local Vel = IsFling and Vector3.new(500, 500, 500) or Vector3.zero
			CurrentLRoot.Velocity = Vel
			CurrentLRoot.RotVelocity = Vel
			attach(CurrentLRoot, TRoot)
		end)
	end)
end

local function SetupWeldBind(Btn, Offset)
	local Conn = nil
	
	Btn.MouseButton1Click:Connect(function()
		if TargetedPlayer == nil then
			SendNotify("Ali hub", "الرجاء اختيار هدف أولاً!", 3)
