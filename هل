--==================================================
-- PLAYER SYSTEM - REDZ LIBRARY
--==================================================

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

local PlayerTab = Window:MakeTab({"اللاعب", "user"})

-- VARIABLES
local SpeedEnabled = false
local JumpEnabled = false
local NoclipEnabled = false
local InfiniteJumpEnabled = false

local SpeedValue = 50
local JumpValue = 100

local NoclipConnection

--==================================================
-- HUMANOID
--==================================================

local function GetHumanoid()
    local Character = Player.Character
    return Character and Character:FindFirstChildOfClass("Humanoid")
end

--==================================================
-- SPEED INPUT
--==================================================

PlayerTab:AddTextBox({
    Name = "سرعة الحركة",
    Description = "اكتب السرعة المطلوبة",
    PlaceholderText = "50",

    Callback = function(Value)
        local Number = tonumber(Value)

        if Number and Number >= 0 and Number <= 250 then
            SpeedValue = Number

            local Humanoid = GetHumanoid()

            if SpeedEnabled and Humanoid then
                Humanoid.WalkSpeed = SpeedValue
            end
        end
    end
})

--==================================================
-- SPEED TOGGLE
--==================================================

PlayerTab:AddToggle({
    Name = "تشغيل السرعة",
    Description = "زيادة سرعة الحركة",
    Default = false,

    Callback = function(Value)
        SpeedEnabled = Value

        local Humanoid = GetHumanoid()

        if Humanoid then
            Humanoid.WalkSpeed = Value and SpeedValue or 16
        end
    end
})

--==================================================
-- JUMP INPUT
--==================================================

PlayerTab:AddTextBox({
    Name = "قوة القفز",
    Description = "اكتب قوة القفز",
    PlaceholderText = "100",

    Callback = function(Value)
        local Number = tonumber(Value)

        if Number and Number >= 0 and Number <= 300 then
            JumpValue = Number

            local Humanoid = GetHumanoid()

            if JumpEnabled and Humanoid then
                Humanoid.UseJumpPower = true
                Humanoid.JumpPower = JumpValue
            end
        end
    end
})

--==================================================
-- JUMP TOGGLE
--==================================================

PlayerTab:AddToggle({
    Name = "تشغيل قوة القفز",
    Description = "زيادة ارتفاع القفز",
    Default = false,

    Callback = function(Value)
        JumpEnabled = Value

        local Humanoid = GetHumanoid()

        if Humanoid then
            Humanoid.UseJumpPower = true
            Humanoid.JumpPower = Value and JumpValue or 50
        end
    end
})

--==================================================
-- NOCLIP
--==================================================

PlayerTab:AddToggle({
    Name = "اختراق الجدران",
    Description = "إيقاف التصادم مع الجدران",
    Default = false,

    Callback = function(Value)
        NoclipEnabled = Value

        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end

        if Value then
            NoclipConnection = RunService.Stepped:Connect(function()
                local Character = Player.Character

                if Character then
                    for _, Part in ipairs(Character:GetDescendants()) do
                        if Part:IsA("BasePart") then
                            Part.CanCollide = false
                        end
                    end
                end
            end)
        else
            local Character = Player.Character

            if Character then
                for _, Part in ipairs(Character:GetDescendants()) do
                    if Part:IsA("BasePart") then
                        Part.CanCollide = true
                    end
                end
            end
        end
    end
})

--==================================================
-- INFINITE JUMP
--==================================================

PlayerTab:AddToggle({
    Name = "قفز لا نهائي",
    Description = "القفز المتكرر",
    Default = false,

    Callback = function(Value)
        InfiniteJumpEnabled = Value
    end
})

UserInputService.JumpRequest:Connect(function()
    if InfiniteJumpEnabled then
        local Humanoid = GetHumanoid()

        if Humanoid then
            Humanoid:ChangeState(
                Enum.HumanoidStateType.Jumping
            )
        end
    end
end)

--==================================================
-- RESPAWN SUPPORT
--==================================================

Player.CharacterAdded:Connect(function(Character)
    local Humanoid = Character:WaitForChild("Humanoid")

    task.wait(0.5)

    if SpeedEnabled then
        Humanoid.WalkSpeed = SpeedValue
    end

    if JumpEnabled then
        Humanoid.UseJumpPower = true
        Humanoid.JumpPower = JumpValue
    end
end)
