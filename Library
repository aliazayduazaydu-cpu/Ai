-- المطور: مطور علاوي
-- قائمة فاضية. أنت تضيف التبويبات والعناصر والأوامر بنفسك من آخر الملف.
--
-- ترتيب الملف:
--   0) أدوات مساعدة
--   1) التحميل (Lib.Load)
--   2) النافذة والتبويبات والعناصر
--   3) الأوامر (Command + الشات)
--   4) مكان إضافة الميزات (آخر الملف)

--==== 0) أدوات مساعدة ====
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local TextChatService = game:GetService("TextChatService")
local StarterGui = game:GetService("StarterGui")

local player = Players.LocalPlayer

local THEME = {
	WindowTransparency = 0.8,   -- شفافية القائمة
	ToggleTransparency = 0.6,   -- شفافية زر الفتح
	BackgroundTransparency = 0.2, -- شفافية صورة الخلفية
	DeveloperTransparency = 0.4,  -- شفافية اسم المطور
	DescTransparency = 0.3,     -- شفافية الشرح
	NameTransparency = 0,       -- شفافية الاسم
}

local Lib = {}
Lib.__index = Lib

local Tab = {}
Tab.__index = Tab

local function has(v)
	return v ~= nil and v ~= ""
end

local function new(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do
		o[k] = v
	end
	o.Parent = parent
	return o
end

local function corner(obj, r)
	new("UICorner", {CornerRadius = UDim.new(0, r)}, obj)
end

-- يخلي الكتابة تشتغل حتى لو اختلفت الهمزات والتاء المربوطة والهاء
local function norm(s)
	s = s:lower()
	s = s:gsub("ة", "ه")
	s = s:gsub("أ", "ا")
	s = s:gsub("إ", "ا")
	s = s:gsub("آ", "ا")
	s = s:gsub("ى", "ي")
	return s
end

-- يفصل اسم الأمر عن الشرح: "سرعة [رقم] | افتراضي 16"
local function splitUsage(usage)
	local c, d = usage:match("^(.-)%s*[|(](.*)$")
	if not c then return usage, "" end
	d = d:gsub("%)%s*$", ""):gsub("^%s+", "")
	c = c:gsub("%s+$", "")
	return c, d
end

local function draggable(handle, target)
	local dragging, startInput, startPos = false, nil, nil
	handle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			startInput = input.Position
			startPos = target.Position
			target:SetAttribute("Dragged", false)
			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)
	UIS.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			local d = input.Position - startInput
			if d.Magnitude > 5 then target:SetAttribute("Dragged", true) end
			target.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
		end
	end)
end

--==== 1) التحميل ====
-- opts (كلها اختيارية):
--   Name, Title, ToggleName, ToggleImage, CloseImage, BackgroundImage, Developer
function Lib.Load(opts)
	opts = opts or {}
	local self = setmetatable({}, Lib)
	self.gui = new("ScreenGui", {Name = opts.Name or "AliLib", ResetOnSpawn = false}, player:WaitForChild("PlayerGui"))
	self.tabs = {}
	self.toggleList = {}
	self.commands = {}
	self.logCount = 0
	self.openImg = opts.ToggleImage
	self.closeImg = opts.CloseImage

	self:_buildWindow(opts)
	self:_hookChat()
	return self
end

--==== 2) النافذة والتبويبات والعناصر ====
function Lib:_buildWindow(opts)
	local gui = self.gui
	local toggleName = has(opts.ToggleName) and opts.ToggleName or "Ali"
	local useImage = has(opts.ToggleImage)

	-- زر الفتح والإغلاق: صورة إذا حطيت رابط، وإلا نص
	local btnProps = {
		Name = toggleName,
		AnchorPoint = Vector2.new(1, 0),
		Size = UDim2.new(0.085, 0, 0.125, 0),
		Position = UDim2.new(1, -10, 0, 10),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = THEME.ToggleTransparency,
		AutoButtonColor = false,
	}
	if useImage then
		btnProps.Image = opts.ToggleImage
		btnProps.ScaleType = Enum.ScaleType.Fit
		self.toggleBtn = new("ImageButton", btnProps, gui)
	else
		btnProps.Text = toggleName
		btnProps.Font = Enum.Font.GothamBold
		btnProps.TextScaled = true
		btnProps.TextColor3 = Color3.new(0, 0, 0)
		self.toggleBtn = new("TextButton", btnProps, gui)
		new("UITextSizeConstraint", {MaxTextSize = 16}, self.toggleBtn)
	end
	corner(self.toggleBtn, 100)
	draggable(self.toggleBtn, self.toggleBtn)
	self.toggleBtn.MouseButton1Click:Connect(function()
		if self.toggleBtn:GetAttribute("Dragged") then return end
		self:SetOpen(not self.open)
	end)

	-- النافذة (تطلع من اليمين)
	self.window = new("Frame", {
		Name = "Window",
		AnchorPoint = Vector2.new(1, 0),
		Size = UDim2.new(0.336, 0, 0.627, 0),
		Position = UDim2.new(1.5, 0, 0.2, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = THEME.WindowTransparency,
	}, gui)
	corner(self.window, 30)
	self.open = false

	-- صورة خلفية اختيارية (شفافيتها 0.2) ما تسوي شي إذا ما حطيت رابط
	if has(opts.BackgroundImage) then
		local bg = new("ImageLabel", {
			Name = "Background",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Image = opts.BackgroundImage,
			ImageTransparency = THEME.BackgroundTransparency,
			ScaleType = Enum.ScaleType.Crop,
			Active = false,
			ZIndex = 0,
		}, self.window)
		corner(bg, 30)
	end

	-- العنوان (اختياري) يسحب النافذة
	local header = new("Frame", {
		Size = UDim2.new(0.951, 0, 0.06, 0),
		Position = UDim2.new(0.0245, 0, 0.01, 0),
		BackgroundTransparency = 1,
		Active = true,
	}, self.window)
	if has(opts.Title) then
		local title = new("TextLabel", {
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			Text = opts.Title,
			Font = Enum.Font.GothamBold,
			TextScaled = true,
			TextColor3 = Color3.new(0, 0, 0),
		}, header)
		new("UITextSizeConstraint", {MaxTextSize = 16}, title)
	end
	draggable(header, self.window)

	-- شريط التبويبات
	self.tabBar = new("ScrollingFrame", {
		Size = UDim2.new(0.951, 0, 0.06, 0),
		Position = UDim2.new(0.0245, 0, 0.08, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 0,
		ScrollingDirection = Enum.ScrollingDirection.X,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.X,
	}, self.window)
	new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, self.tabBar)

	-- مكان الصفحات
	self.pageHolder = new("Frame", {
		Size = UDim2.new(0.951, 0, 0.66, 0),
		Position = UDim2.new(0.0245, 0, 0.15, 0),
		BackgroundTransparency = 1,
		ClipsDescendants = true,
	}, self.window)

	-- خانة الأوامر (الشات)
	self.input = new("TextBox", {
		Size = UDim2.new(0.7, 0, 0.07, 0),
		Position = UDim2.new(0.0245, 0, 0.82, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		ClearTextOnFocus = false,
		PlaceholderText = "اكتب أمر...",
		Text = "",
		Font = Enum.Font.GothamSemibold,
		TextScaled = true,
		TextColor3 = Color3.new(0, 0, 0),
		PlaceholderColor3 = Color3.new(0.4, 0.4, 0.4),
