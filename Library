	return r
end

-- زر: يرجع الزر نفسه
function Tab:Button(name, desc, callback)
	local r = row(self, 40)
	labelPair(r, name, desc)
	local hit = new("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, r)
	hit.MouseButton1Click:Connect(function()
		if callback then callback() end
	end)
	return hit
end

-- مفتاح تشغيل/إيقاف: يرجع Set و Get
function Tab:Toggle(name, default, callback)
	local state = default == true
	local r = row(self, 40)
	local status = labelPair(r, name, state and "مفعل" or "متوقف")
	local hit = new("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 2,
	}, r)

	local function set(v)
		state = v and true or false
		status.Text = state and "مفعل" or "متوقف"
		if callback then callback(state) end
	end

	hit.MouseButton1Click:Connect(function()
		set(not state)
	end)
	table.insert(self.lib.toggleList, {get = function() return state end, set = set})
	return {Set = set, Get = function() return state end}
end

-- خانة إدخال: تستدعي callback بالنص لما تخلص الكتابة
function Tab:Input(name, default, callback)
	local r = row(self, 40)
	local box = new("TextBox", {
		Size = UDim2.new(0.42, 0, 0.7, 0),
		Position = UDim2.new(0, 8, 0.15, 0),
		BackgroundColor3 = Color3.fromRGB(235, 235, 235),
		ClearTextOnFocus = false,
		Text = tostring(default or ""),
		PlaceholderText = "...",
		Font = Enum.Font.GothamSemibold,
		TextScaled = true,
		TextColor3 = Color3.new(0, 0, 0),
	}, r)
	corner(box, 8)
	new("TextLabel", {
		Size = UDim2.new(0.5, -8, 1, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Color3.new(0, 0, 0),
		Text = name,
	}, r)
	box.FocusLost:Connect(function()
		if callback then callback(box.Text) end
	end)
	return box
end

--==== 3) الأوامر ====
-- تبويب الأوامر ينشأ تلقائياً أول مرة تسجل فيها أمر
function Lib:_getCmdTab()
	if not self.cmdTab then
		self.cmdTab = self:Tab("الأوامر")
		local box = new("TextBox", {
			Size = UDim2.new(1, -6, 0, 36),
			BackgroundColor3 = Color3.fromRGB(235, 235, 235),
			ClearTextOnFocus = false,
			PlaceholderText = "ابحث عن أمر...",
			Text = "",
			Font = Enum.Font.GothamSemibold,
			TextScaled = true,
			TextColor3 = Color3.new(0, 0, 0),
			LayoutOrder = 0,
		}, self.cmdTab.page)
		corner(box, 12)
		box:GetPropertyChangedSignal("Text"):Connect(function()
			local q = norm(box.Text)
			for _, child in ipairs(self.cmdTab.page:GetChildren()) do
				local s = child:GetAttribute("Search")
				if s then
					child.Visible = (q == "") or (s:find(q, 1, true) ~= nil)
				end
			end
		end)
		self.cmdSearch = box
	end
	return self.cmdTab
end

-- يسجل أمر: names = الأسماء، usage = الشرح، fn = الدالة (تستقبل النص اللي بعد الأمر)
function Lib:Command(names, usage, fn)
	for _, n in ipairs(names) do
		self.commands[norm(n)] = fn
	end
	local cmdPart, desc = splitUsage(usage)
	local lib = self
	local b = self:_getCmdTab():Button(cmdPart, desc, function()
		lib.input.Text = names[1] .. " "
		lib.input:CaptureFocus()
	end)
	b.Parent:SetAttribute("Search", norm(cmdPart .. " " .. desc))
end

-- رسالة في تبويب السجل (ينشأ أول مرة)، وإشعار اختياري
function Lib:Notify(text, popup)
	if not self.logTab then
		self.logTab = self:Tab("السجل")
	end
	self.logCount = self.logCount + 1
	local l = new("TextLabel", {
		Size = UDim2.new(1, -6, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Enum.Font.Gotham,
		TextSize = 13,
		TextColor3 = Color3.new(0, 0, 0),
		Text = tostring(text),
		LayoutOrder = self.logCount,
	}, self.logTab.page)
	corner(l, 10)
	if popup then
		pcall(function()
			StarterGui:SetCore("SendNotification", {Title = "AliLib", Text = tostring(text), Duration = 3})
		end)
	end
end

-- ينفذ النص (يتجاهل ; و / في البداية، ويقبل الأسماء بمسافات)
function Lib:_run(text)
	text = (text or ""):match("^%s*[;/]?%s*(.-)%s*$") or ""
	if text == "" then return end
	local lower = norm(text)
	local best = nil
	for name in pairs(self.commands) do
		if lower == name or lower:sub(1, #name + 1) == name .. " " then
			if not best or #name > #best then best = name end
		end
	end
	if not best then
		self:Notify("أمر غير معروف: " .. text, true)
		return
	end
	local arg = text:sub(#best + 2):match("^%s*(.-)%s*$") or ""
	local ok, err = pcall(self.commands[best], arg)
	if not ok then self:Notify("خطأ: " .. tostring(err), true) end
end

-- الأوامر المكتوبة في الشات (تبدأ بـ ; أو /)
function Lib:_hookChat()
	TextChatService.MessageReceived:Connect(function(msg)
		if msg.TextSource and msg.TextSource.UserId == player.UserId and msg.Text:match("^%s*[;/]") then
			self:_run(msg.Text)
		end
	end)
	player.Chatted:Connect(function(msg)
		if msg:match("^%s*[;/]") then self:_run(msg) end
	end)
end

