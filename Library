function Lib:SetOpen(open)
	self.open = open
	-- إذا حاطيت صورة إغلاق، تتبدل الصورة
	if self.toggleBtn:IsA("ImageButton") and has(self.closeImg) then
		self.toggleBtn.Image = open and self.closeImg or self.openImg
	end
	TweenService:Create(self.window, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
		Position = open and UDim2.new(1, -10, 0.2, 0) or UDim2.new(1.5, 0, 0.2, 0),
	}):Play()
end

function Lib:_submit()
	local text = self.input.Text
	self.input.Text = ""
	if text ~= "" then self:_run(text) end
end

-- إنشاء تبويب جديد
function Lib:Tab(name)
	local page = new("ScrollingFrame", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(0, 0, 0, 0),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		Visible = false,
	}, self.pageHolder)
	new("UIListLayout", {Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder}, page)

	local btn = new("TextButton", {
		Size = UDim2.new(0, 90, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0.6,
		AutoButtonColor = false,
		Text = name,
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = Color3.new(0, 0, 0),
		LayoutOrder = #self.tabs + 1,
	}, self.tabBar)
	corner(btn, 10)
	new("UITextSizeConstraint", {MaxTextSize = 13}, btn)

	local tab = setmetatable({lib = self, page = page, btn = btn, order = 0}, Tab)
	btn.MouseButton1Click:Connect(function()
		self:_showTab(tab)
	end)
	table.insert(self.tabs, tab)
	-- أول تبويب يطلع تلقائياً
	if #self.tabs == 1 then self:_showTab(tab) end
	return tab
end

function Lib:_showTab(tab)
	for _, t in ipairs(self.tabs) do
		t.page.Visible = (t == tab)
		t.btn.BackgroundTransparency = (t == tab) and 0 or 0.6
	end
end

-- صف أساسي داخل التبويب
local function row(tab, h)
	tab.order = tab.order + 1
	local r = new("Frame", {
		Size = UDim2.new(1, -6, 0, h),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 0,
		LayoutOrder = tab.order,
	}, tab.page)
	corner(r, 12)
	return r
end

-- الشرح يسار بشفافية 0.3، والاسم يمين بشفافية 0
local function labelPair(r, name, desc)
	local left = new("TextLabel", {
		Size = UDim2.new(0.55, 0, 1, 0),
		Position = UDim2.new(0, 8, 0, 0),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextColor3 = Color3.new(0, 0, 0),
		TextTransparency = THEME.DescTransparency,
		Text = desc or "",
	}, r)
	local right = new("TextLabel", {
		Size = UDim2.new(0.45, -8, 1, 0),
		Position = UDim2.new(0.55, 0, 0, 0),
		BackgroundTransparency = 1,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Right,
		Font = Enum.Font.GothamBold,
		TextSize = 13,
		TextColor3 = Color3.new(0, 0, 0),
		TextTransparency = THEME.NameTransparency,
		Text = name or "",
	}, r)
	return left, right
end

