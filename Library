		Size = UDim2.new(0.2255, 0, 0.07, 0),
		Position = UDim2.new(0.75, 0, 0.82, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		AutoButtonColor = false,
		Text = "إرسال",
		Font = Enum.Font.GothamBold,
		TextScaled = true,
		TextColor3 = Color3.new(0, 0, 0),
