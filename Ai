local lastAbilityKey = ""
local function refreshAbilities()
	local parts = {}
	for k in pairs(Mem.abilities) do table.insert(parts, "c:" .. k) end
	for k, rule in pairs(Mem.rules) do
		if confidence(rule) >= CFG.RuleAnnounce then table.insert(parts, "r:" .. k) end
	end
	table.sort(parts)
	local key = table.concat(parts, ";")
	if key == lastAbilityKey then return end
	lastAbilityKey = key

	for _, child in ipairs(abilityList:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for _, ab in pairs(Mem.abilities) do
		btn(abilityList, "▶ " .. ab.name, function() runAbility(ab) end)
	end
	for k, rule in pairs(Mem.rules) do
		if confidence(rule) >= CFG.RuleAnnounce then
			local kind, target = k:match("^(%a+)::(.+)$")
			local short = (target or k):sub(-22)
			btn(abilityList, "⚡ " .. (kind == "tool" and "أداة " or "زر ") .. short, function()
				if R.running and not R.busy then
					R.busy = true
					task.spawn(function()
						useRule(k)
						R.busy = false
					end)
				end
			end)
		end
	end
	noAbility.Visible = (#parts == 0)
end

