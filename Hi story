local AutoTools = {}

local AutoSection = ToolsTab:Section({
    Name = "الأخذ التلقائي",
    column = 2
})

local function CreateAutoTool(Name, ToolName)
    AutoTools[Name] = false

    AutoSection:Toggle({
        Name = Name,
        Flag = "Auto_" .. Name,

        Callback = function(Value)
            AutoTools[Name] = Value

            if Value then
                task.spawn(function()
                    while AutoTools[Name] do
                        GetTool(ToolName)
                        task.wait()
                    end
                end)
            end
        end
    })
end

CreateAutoTool("أوتو تفاحه", "Apple")
