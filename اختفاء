local function makeButton(parent, order, text, onClick)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -6, 0, 34)
	b.LayoutOrder = order
	b.BackgroundColor3 = CONFIG.ACCENT
	b.TextColor3 = CONFIG.TEXT
	b.Font = Enum.Font.GothamBold
	b.TextSize = 11
	b.Text = text
	b.AutoButtonColor = false
	b.Parent = parent
	Instance.new("UICorner", b).CornerRadius = UDim.new(0, 8)
	local s = Instance.new("UIStroke", b)
	s.Color = Color3.new(1, 1, 1)
	s.Transparency = 0.9
	b.MouseEnter:Connect(function()
		TweenService:Create(s, TweenInfo.new(0.2), { Transparency = 0.5, Color = CONFIG.PRIMARY }):Play()
	end)
	b.MouseLeave:Connect(function()
		TweenService:Create(s, TweenInfo.new(0.2), { Transparency = 0.9, Color = Color3.new(1, 1, 1) }):Play()
	end)
	b.MouseButton1Click:Connect(onClick)
	return b
end

local function makeToggle(parent, order, label, onSet)
	local ctrl = { on = false }
	ctrl.btn = makeButton(parent, order, label, function()
		ctrl.set(not ctrl.on)
	end)
	ctrl.set = function(on)
		ctrl.on = on
		ctrl.btn.Text = label .. (on and "  ✓" or "")
		TweenService:Create(ctrl.btn, TweenInfo.new(0.25), {
			TextColor3 = on and CONFIG.SUCCESS or CONFIG.TEXT,
		}):Play()
		onSet(on)
	end
	return ctrl
end

