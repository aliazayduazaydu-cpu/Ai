-------------------------------------------------
-- Input
-------------------------------------------------
UIS.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == CONFIG.INVIS_KEY then
		invisCtrl.set(not invisCtrl.on)
		return
	end
	if state.fly and (input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1) then
		flyHeld = true
		setFlyTargetFromScreen(input.Position.X, input.Position.Y)
	end
end)

UIS.InputChanged:Connect(function(input)
	if state.fly and flyHeld and (input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseMovement) then
		setFlyTargetFromScreen(input.Position.X, input.Position.Y)
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
		or input.UserInputType == Enum.UserInputType.MouseButton1 then
		flyHeld = false
	end
end)

UIS.JumpRequest:Connect(function()
	if state.infJump and getChar() then
		local hum = getHum()
		if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
	end
end)

-------------------------------------------------
-- Loops
-------------------------------------------------
RunService.Stepped:Connect(function()
	if state.noclip and getChar() then
		for _, part in ipairs(getChar():GetDescendants()) do
			if part:IsA("BasePart") and part.CanCollide then
				part.CanCollide = false
			end
		end
	end
end)

RunService.Heartbeat:Connect(function()
	if not state.fly then return end
	local hrp = getHRP()
	if not hrp then return end
	if flyTarget then
		local diff = flyTarget - hrp.Position
		if diff.Magnitude > 2 then
			hrp.AssemblyLinearVelocity = diff.Unit * CONFIG.FLY_SPEED
		else
			flyTarget = nil
			hrp.AssemblyLinearVelocity = Vector3.zero
		end
	else
		hrp.AssemblyLinearVelocity = Vector3.zero
	end
end)

player.CharacterAdded:Connect(function(char)
	flyTarget = nil
	local hum = char:WaitForChild("Humanoid", 5)
	if hum then
		if state.speed then hum.WalkSpeed = CONFIG.BOOSTED_SPEED end
		if state.fly then hum.PlatformStand = true end
	end
end)

for _, p in ipairs(Players:GetPlayers()) do makeESP(p) end
Players.PlayerAdded:Connect(makeESP)
