-- Visual features
-------------------------------------------------
local function setESP(on)
	state.esp = on
	for i = #espObjects, 1, -1 do
		local obj = espObjects[i]
		if obj.Parent then
			obj.Enabled = on
		else
			table.remove(espObjects, i)
		end
	end
end

local function makeESP(p)
	if p == player then return end
	local function onChar(char)
		local head = char:WaitForChild("Head", 5)
		if not head then return end

		local bb = Instance.new("BillboardGui")
		bb.Name = "ZiaaESPName"
		bb.Size = UDim2.fromOffset(120, 30)
		bb.StudsOffset = Vector3.new(0, 3, 0)
		bb.AlwaysOnTop = true
		bb.Adornee = head
		bb.Enabled = state.esp
		bb.Parent = head

		local lbl = Instance.new("TextLabel")
		lbl.Size = UDim2.fromScale(1, 1)
		lbl.BackgroundTransparency = 1
		lbl.Text = p.Name
		lbl.TextColor3 = CONFIG.SUCCESS
		lbl.TextStrokeTransparency = 0.3
		lbl.Font = Enum.Font.GothamBold
		lbl.TextSize = 12
		lbl.Parent = bb

		local hl = Instance.new("Highlight")
		hl.FillTransparency = 0.75
		hl.OutlineColor = CONFIG.SUCCESS
		hl.Enabled = state.esp
		hl.Parent = char

		table.insert(espObjects, bb)
		table.insert(espObjects, hl)
	end
	if p.Character then task.spawn(onChar, p.Character) end
	p.CharacterAdded:Connect(onChar)
end

local function setBright(on)
	state.bright = on
	if on then
		Lighting.Brightness = 3
		Lighting.ClockTime = 14
		Lighting.GlobalShadows = false
		Lighting.Ambient = Color3.fromRGB(180, 180, 180)
		Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
	else
		Lighting.Brightness = originalLighting.Brightness
		Lighting.ClockTime = originalLighting.ClockTime
		Lighting.GlobalShadows = originalLighting.GlobalShadows
		Lighting.Ambient = originalLighting.Ambient
		Lighting.OutdoorAmbient = originalLighting.OutdoorAmbient
	end
end

-------------------------------------------------
-- Weather effects
-------------------------------------------------
local function clearWeather()
	stormRunning = false
	for _, o in ipairs(weatherObjects) do
		if o.Parent then o:Destroy() end
	end
	table.clear(weatherObjects)
	Lighting.FogEnd = originalLighting.FogEnd
	Lighting.FogColor = originalLighting.FogColor
end

local function applyWeather(kind)
	clearWeather()
	local atm = Instance.new("Atmosphere")
	local cc = Instance.new("ColorCorrection")
	atm.Parent = Lighting
	cc.Parent = Lighting
	table.insert(weatherObjects, atm)
	table.insert(weatherObjects, cc)

	if kind == "clouds" then
		atm.Density = 0.35
		atm.Haze = 1.5
		atm.Glare = 0.2
		atm.Color = Color3.fromRGB(245, 245, 250)
		cc.Brightness = 0.08
		cc.Contrast = -0.05
		Lighting.FogColor = Color3.fromRGB(235, 238, 242)
		Lighting.FogEnd = 1200
	elseif kind == "storm" then
		atm.Density = 0.6
		atm.Haze = 3
		atm.Color = Color3.fromRGB(230, 232, 236)
		atm.Decay = Color3.fromRGB(200, 205, 215)
		cc.Brightness = -0.05
		cc.Contrast = 0.1
		cc.Saturation = -0.4
		Lighting.FogColor = Color3.fromRGB(220, 224, 230)
		Lighting.FogEnd = 350

		stormRunning = true
		task.spawn(function()
			while stormRunning and cc.Parent do
				task.wait(math.random(3, 7))
				if not stormRunning or not cc.Parent then break end
				cc.Brightness = 0.6
				task.wait(0.05)
				cc.Brightness = -0.05
				task.wait(0.08)
				cc.Brightness = 0.4
				task.wait(0.05)
				cc.Brightness = -0.05
			end
		end)
	end
end

