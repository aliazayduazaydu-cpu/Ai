local function setMenu(open)
	menuOpen = open
	if open then
		menu.Visible = true
		TweenService:Create(menuScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = openScale }):Play()
