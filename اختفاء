-------------------------------------------------
-- Helpers
-------------------------------------------------
local function getChar() return player.Character end
local function getHum()
	local c = getChar()
	return c and c:FindFirstChildOfClass("Humanoid")
end
local function getHRP()
	local c = getChar()
	return c and c:FindFirstChild("HumanoidRootPart")
end

local function setCharTransparency(char, t)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") or d:IsA("Decal") then
			d.Transparency = t
		end
	end
end

-------------------------------------------------
-- Player features
-------------------------------------------------
local invisChairName = "ZiaaInvisChair"

local function setInvisible(on)
	local char, hrp = getChar(), getHRP()
	if not char or not hrp then return end
	state.invisible = on
	if on then
		local saved = hrp.CFrame
		char:MoveTo(CONFIG.INVIS_POS)
		task.wait(0.15)
		local seat = Instance.new("Seat")
		seat.Name = invisChairName
		seat.Anchored = false
		seat.CanCollide = false
		seat.Transparency = 1
		seat.Position = CONFIG.INVIS_POS
		seat.Parent = workspace
		local torso = char:FindFirstChild("Torso") or char:FindFirstChild("UpperTorso")
		if torso then
			local weld = Instance.new("Weld")
			weld.Part0 = seat
			weld.Part1 = torso
			weld.Parent = seat
		end
		task.wait()
		seat.CFrame = saved
		setCharTransparency(char, 0.5)
	else
		local chair = workspace:FindFirstChild(invisChairName)
		if chair then chair:Destroy() end
		local c = getChar()
		if c then setCharTransparency(c, 0) end
	end
end

local function setSpeed(on)
	state.speed = on
	local hum = getHum()
	if hum then
		hum.WalkSpeed = on and CONFIG.BOOSTED_SPEED or CONFIG.DEFAULT_SPEED
	end
end

local function setNoclip(on) state.noclip = on end
local function setInfJump(on) state.infJump = on end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function setFlyTargetFromScreen(x, y)
	local ray = camera:ViewportPointToRay(x, y)
	local char = getChar()
	if char then rayParams.FilterDescendantsInstances = { char } end
	local result = workspace:Raycast(ray.Origin, ray.Direction * 1000, rayParams)
	if result then
		flyTarget = result.Position + Vector3.new(0, 3, 0)
	else
		flyTarget = ray.Origin + ray.Direction * 200
	end
end

local function setFly(on)
	state.fly = on
	flyTarget = nil
	flyHeld = false
	local hum, hrp = getHum(), getHRP()
	if hum then hum.PlatformStand = on end
	if hrp and not on then hrp.AssemblyLinearVelocity = Vector3.zero end
end

